CHIP_ROCK_RIGHT_B = $09
CHIP_ROCK_CTL = $0A
CHIP_ROCK_CTR = $0B
CHIP_ROCK_CBL = $0C
CHIP_ROCK_CBR = $0D
CHIP_MAGMA_TOP = $0E
CHIP_MAGMA_BOTTOM = $0F
CHIP_TREASURE_TOP = $10
CHIP_TREASURE_BOTTOM = $11
CHIP_BRICK_FACE_A = $12
CHIP_BRICK_FACE_B = $13
CHIP_BRICK_FACE_CRACK = $14
