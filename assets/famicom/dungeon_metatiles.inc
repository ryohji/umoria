; --- 壁: 1/4 ごとのチップ ---
; wall_<種類>: 左上・右上・左下・右下の順に 4 組。各組は 2 辺の状態
;   0 どちらも床に面していない / 1 左右の辺だけ（左上なら左）/ 2 上下の辺だけ（左上なら上）/ 3 両方
; を模様 A・B で 2 通り（計 8 バイト）。岩の模様は (x + y) & 1 で選ぶ

; 岩の壁（花崗岩）。通路のまわり。外周の壁と隠し扉も同じ（パレット P1）
wall_rock:
    .byte CHIP_BLACK,CHIP_BLACK,CHIP_ROCK_LEFT_A,CHIP_ROCK_LEFT_B,CHIP_ROCK_TOP_A,CHIP_ROCK_TOP_B,CHIP_ROCK_CTL,CHIP_ROCK_CTL  ; tl
    .byte CHIP_BLACK,CHIP_BLACK,CHIP_ROCK_RIGHT_B,CHIP_ROCK_RIGHT_A,CHIP_ROCK_TOP_B,CHIP_ROCK_TOP_A,CHIP_ROCK_CTR,CHIP_ROCK_CTR  ; tr
    .byte CHIP_BLACK,CHIP_BLACK,CHIP_ROCK_LEFT_B,CHIP_ROCK_LEFT_A,CHIP_ROCK_BOTTOM_B,CHIP_ROCK_BOTTOM_A,CHIP_ROCK_CBL,CHIP_ROCK_CBL  ; bl
    .byte CHIP_BLACK,CHIP_BLACK,CHIP_ROCK_RIGHT_A,CHIP_ROCK_RIGHT_B,CHIP_ROCK_BOTTOM_A,CHIP_ROCK_BOTTOM_B,CHIP_ROCK_CBR,CHIP_ROCK_CBR  ; br

; レンガの壁。部屋のまわり（パレット P2）
wall_brick:
    .byte CHIP_BLACK,CHIP_BLACK,CHIP_BRICK_CAP_LEFT,CHIP_BRICK_CAP_LEFT,CHIP_BRICK_CAP_TOP,CHIP_BRICK_CAP_TOP,CHIP_BRICK_CTL,CHIP_BRICK_CTL  ; tl
    .byte CHIP_BLACK,CHIP_BLACK,CHIP_BRICK_CAP_RIGHT,CHIP_BRICK_CAP_RIGHT,CHIP_BRICK_CAP_TOP,CHIP_BRICK_CAP_TOP,CHIP_BRICK_CTR,CHIP_BRICK_CTR  ; tr
    .byte CHIP_BLACK,CHIP_BLACK,CHIP_BRICK_CAP_LEFT,CHIP_BRICK_CAP_LEFT,CHIP_BRICK_FACE_B,CHIP_BRICK_FACE_A,CHIP_BRICK_CBL,CHIP_BRICK_CBL  ; bl
    .byte CHIP_BLACK,CHIP_BLACK,CHIP_BRICK_CAP_RIGHT,CHIP_BRICK_CAP_RIGHT,CHIP_BRICK_FACE_A,CHIP_BRICK_FACE_B,CHIP_BRICK_CBR,CHIP_BRICK_CBR  ; br

; 溶岩の鉱脈（パレット P1）
wall_magma:
    .byte CHIP_BLACK,CHIP_BLACK,CHIP_ROCK_LEFT_A,CHIP_ROCK_LEFT_B,CHIP_MAGMA_TOP,CHIP_MAGMA_TOP,CHIP_ROCK_CTL,CHIP_ROCK_CTL  ; tl
    .byte CHIP_BLACK,CHIP_BLACK,CHIP_ROCK_RIGHT_B,CHIP_ROCK_RIGHT_A,CHIP_MAGMA_TOP,CHIP_MAGMA_TOP,CHIP_ROCK_CTR,CHIP_ROCK_CTR  ; tr
    .byte CHIP_BLACK,CHIP_BLACK,CHIP_ROCK_LEFT_B,CHIP_ROCK_LEFT_A,CHIP_MAGMA_BOTTOM,CHIP_MAGMA_BOTTOM,CHIP_ROCK_CBL,CHIP_ROCK_CBL  ; bl
    .byte CHIP_BLACK,CHIP_BLACK,CHIP_ROCK_RIGHT_A,CHIP_ROCK_RIGHT_B,CHIP_MAGMA_BOTTOM,CHIP_MAGMA_BOTTOM,CHIP_ROCK_CBR,CHIP_ROCK_CBR  ; br

; 石英の鉱脈（岩のチップを P2 で使う）（パレット P2）
wall_quartz:
    .byte CHIP_BLACK,CHIP_BLACK,CHIP_ROCK_LEFT_A,CHIP_ROCK_LEFT_B,CHIP_ROCK_TOP_A,CHIP_ROCK_TOP_B,CHIP_ROCK_CTL,CHIP_ROCK_CTL  ; tl
    .byte CHIP_BLACK,CHIP_BLACK,CHIP_ROCK_RIGHT_B,CHIP_ROCK_RIGHT_A,CHIP_ROCK_TOP_B,CHIP_ROCK_TOP_A,CHIP_ROCK_CTR,CHIP_ROCK_CTR  ; tr
    .byte CHIP_BLACK,CHIP_BLACK,CHIP_ROCK_LEFT_B,CHIP_ROCK_LEFT_A,CHIP_ROCK_BOTTOM_B,CHIP_ROCK_BOTTOM_A,CHIP_ROCK_CBL,CHIP_ROCK_CBL  ; bl
    .byte CHIP_BLACK,CHIP_BLACK,CHIP_ROCK_RIGHT_A,CHIP_ROCK_RIGHT_B,CHIP_ROCK_BOTTOM_A,CHIP_ROCK_BOTTOM_B,CHIP_ROCK_CBR,CHIP_ROCK_CBR  ; br

; 溶岩の鉱脈＋宝（パレット P1）
wall_magma_t:
    .byte CHIP_BLACK,CHIP_BLACK,CHIP_ROCK_LEFT_A,CHIP_ROCK_LEFT_B,CHIP_TREASURE_TOP,CHIP_TREASURE_TOP,CHIP_ROCK_CTL,CHIP_ROCK_CTL  ; tl
    .byte CHIP_BLACK,CHIP_BLACK,CHIP_ROCK_RIGHT_B,CHIP_ROCK_RIGHT_A,CHIP_MAGMA_TOP,CHIP_MAGMA_TOP,CHIP_ROCK_CTR,CHIP_ROCK_CTR  ; tr
    .byte CHIP_BLACK,CHIP_BLACK,CHIP_ROCK_LEFT_B,CHIP_ROCK_LEFT_A,CHIP_TREASURE_BOTTOM,CHIP_TREASURE_BOTTOM,CHIP_ROCK_CBL,CHIP_ROCK_CBL  ; bl
    .byte CHIP_BLACK,CHIP_BLACK,CHIP_ROCK_RIGHT_A,CHIP_ROCK_RIGHT_B,CHIP_MAGMA_BOTTOM,CHIP_MAGMA_BOTTOM,CHIP_ROCK_CBR,CHIP_ROCK_CBR  ; br

; 石英の鉱脈＋宝（パレット P2）
wall_quartz_t:
    .byte CHIP_BLACK,CHIP_BLACK,CHIP_ROCK_LEFT_A,CHIP_ROCK_LEFT_B,CHIP_TREASURE_TOP,CHIP_TREASURE_TOP,CHIP_ROCK_CTL,CHIP_ROCK_CTL  ; tl
    .byte CHIP_BLACK,CHIP_BLACK,CHIP_ROCK_RIGHT_B,CHIP_ROCK_RIGHT_A,CHIP_ROCK_TOP_B,CHIP_ROCK_TOP_A,CHIP_ROCK_CTR,CHIP_ROCK_CTR  ; tr
    .byte CHIP_BLACK,CHIP_BLACK,CHIP_ROCK_LEFT_B,CHIP_ROCK_LEFT_A,CHIP_TREASURE_BOTTOM,CHIP_TREASURE_BOTTOM,CHIP_ROCK_CBL,CHIP_ROCK_CBL  ; bl
    .byte CHIP_BLACK,CHIP_BLACK,CHIP_ROCK_RIGHT_A,CHIP_ROCK_RIGHT_B,CHIP_ROCK_BOTTOM_A,CHIP_ROCK_BOTTOM_B,CHIP_ROCK_CBR,CHIP_ROCK_CBR  ; br
brick_face_crack = CHIP_BRICK_FACE_CRACK  ; レンガの正面は時々ひびに差しかえる

; --- 床: 模様（位置で選ぶ）。影は左上・右上・左下の 1/4 を差しかえる ---
; 上が壁: 左上と右上を SHADOW_TOP / 左が壁: 左上と左下を SHADOW_LEFT
; 上と左が壁: 左上を SHADOW_TL / 左上だけ壁: 左上を SHADOW_DOT
floor_sand:   ; P0
    .byte CHIP_BLANK,CHIP_BLANK,CHIP_BLANK,CHIP_BLANK
    .byte CHIP_RIPPLE_A,CHIP_BLANK,CHIP_BLANK,CHIP_RIPPLE_B
    .byte CHIP_BLANK,CHIP_RIPPLE_B,CHIP_RIPPLE_A,CHIP_BLANK
    .byte CHIP_RIPPLE_B,CHIP_BLANK,CHIP_BLANK,CHIP_BLANK
    .byte CHIP_BLANK,CHIP_BLANK,CHIP_RIPPLE_A,CHIP_BLANK
floor_paved:  ; P0（部屋）
    .byte CHIP_TILE_BIG,CHIP_TILE_BIG,CHIP_TILE_BIG,CHIP_TILE_BIG
    .byte CHIP_TILE_SMALL,CHIP_TILE_SMALL,CHIP_TILE_SMALL,CHIP_TILE_SMALL
    .byte CHIP_TILE_BIG,CHIP_TILE_CRACK,CHIP_TILE_BIG,CHIP_TILE_BIG
    .byte CHIP_TILE_BIG,CHIP_TILE_BIG,CHIP_TILE_WORN,CHIP_TILE_BIG
    .byte CHIP_TILE_BIG,CHIP_TILE_SMALL,CHIP_TILE_SMALL,CHIP_TILE_BIG
    .byte CHIP_TILE_BRICK,CHIP_TILE_BRICK,CHIP_TILE_BRICK,CHIP_TILE_BRICK
    .byte CHIP_TILE_WORN,CHIP_TILE_BIG,CHIP_TILE_BIG,CHIP_TILE_SMALL
floor_pebble: ; P1（影の無い通路の床に時々）
    .byte CHIP_BLANK,CHIP_BLANK,CHIP_BLANK,CHIP_PEBBLE

; --- そのほかのメタタイル（左上・右上・左下・右下, パレット） ---
mt_void: .byte CHIP_BLACK,CHIP_BLACK,CHIP_BLACK,CHIP_BLACK, 1  ; 未探索の闇（壁の奥と同じ黒）
mt_door_closed: .byte CHIP_DOOR_L,CHIP_DOOR_R,CHIP_DOOR_L,CHIP_DOOR_R, 1  ; 閉じた扉（縦横どちらの壁でも同じ）
mt_door_open: .byte CHIP_DOOR_OPEN_L,CHIP_DOOR_OPEN_R,CHIP_DOOR_OPEN_L,CHIP_DOOR_OPEN_R, 1  ; 開いた扉・壊れた扉
mt_stairs_up: .byte CHIP_STEPS_L,CHIP_STEPS_R,CHIP_STEPS_L,CHIP_STEPS_R, 0  ; 上り階段 <
mt_stairs_down: .byte CHIP_STEPS_L,CHIP_STEPS_R,CHIP_STEPS_DARK_L,CHIP_STEPS_DARK_R, 0  ; 下り階段 >（下半分が闇）
mt_rubble: .byte CHIP_BOULDER_B,CHIP_BOULDER_A,CHIP_BOULDER_A,CHIP_BOULDER_B, 1  ; 瓦礫 :
mt_trap_pit: .byte CHIP_PIT_TL,CHIP_PIT_TR,CHIP_PIT_BL,CHIP_PIT_BR, 0  ; 落とし穴
mt_trap_door: .byte CHIP_PLANKS,CHIP_PLANKS,CHIP_PLANKS,CHIP_PLANKS, 1  ; 落とし戸
mt_trap_dart: .byte CHIP_PLATE,CHIP_PLATE,CHIP_PLATE,CHIP_PLATE, 0  ; 矢・吹き矢の罠
mt_trap_gas: .byte CHIP_GRATE,CHIP_GRATE,CHIP_GRATE,CHIP_GRATE, 0  ; ガスの罠
mt_trap_rune: .byte CHIP_RING_TL,CHIP_RING_TR,CHIP_RING_BL,CHIP_RING_BR, 0  ; 不思議なルーン（明るい輪）
mt_glyph: .byte CHIP_RING_TL,CHIP_RING_TR,CHIP_RING_BL,CHIP_RING_BR, 1  ; 守りのルーン（ルーンと同じ絵を岩の色で）
mt_trap_fire: .byte CHIP_SCORCH,CHIP_BLANK,CHIP_BLANK,CHIP_SCORCH, 0  ; 焦げ跡（火炎の罠）
mt_trap_rock: .byte CHIP_PEBBLE,CHIP_BOULDER_A,CHIP_BLANK,CHIP_PEBBLE, 1  ; 落石の罠
mt_trap_acid: .byte CHIP_BLANK,CHIP_ACID,CHIP_ACID,CHIP_BLANK, 3  ; 酸の罠

; --- 見本（モンスター・アイテム。地形とは別に数える） ---
mt_ex_jelly: .byte $3F,$40,$41,$42, 3  ; 見本: ゼリー J
mt_ex_gold: .byte $43,$44,$45,$46, 1  ; 見本: 金貨の山 $（這う硬貨と共用）
mt_ex_potion: .byte $47,$48,$49,$4A, 2  ; 見本: 薬瓶 !

