# BINDIR is the directory where the moria binary will be put
# LIBDIR is where the other files (score, news, hours) will be put
# LIBDIR must be the same directory defined in config.h
BINDIR = C:/umoria
LIBDIR = C:/umoria/data

# Game binary name. e.g `moria` or `umoria`.
TARGET = umoria

# Custom include paths. e.g. ncurses includes for MinGW on Windows.
INC = -I/usr/include/ncurses/

# For testing and debugging the program, it is best to use this line.
CFLAGS = -g -Wall -std=gnu11 $(INC)

# For playing the game, you may want to use this line
# CFLAGS = -O
# NOTE: the -O flag currently crashes the game when running! -- MRC (2016-09-30)

# Required for GCC compilation under MinGW
PTHREAD = -static -lpthread

CURSES = -lncurses

LFLAGS =

# GCC is required when using MinGW
CC = gcc

# src/ の .c の一覧は根の sources.mk に 1 つだけ書く（makefile が読むのと
# 同じもの）。このファイルは src/ の中で動かす前提（.o と .d を src/ に作る）
# なので、sources.mk はこのファイルの置き場から探す。
include $(dir $(lastword $(MAKEFILE_LIST)))sources.mk

# .o は src/ に名前だけで並べる。.c と
# ヘッダは VPATH で src/ のサブディレクトリー（sources.mk の SRC_SUBDIRS）から
# 探す。#include "..." のほうは -iquote で同じディレクトリーを足す。-I では
# なく -iquote にしているのは、#include <...> の探し先を前と同じ（src/ を
# 見ない）に保つため（このリポジトリーの curses.h が <curses.h> を横取りしない）。
VPATH = $(SRC_SUBDIRS)
INC += -iquote . $(addprefix -iquote ,$(SRC_SUBDIRS))

OBJS = $(notdir $(SRCS:.c=.o))

# app/ objects (linked directly, not in any archive). APP_SRCS also includes
# the two ncurses files (platform layer, but not in any archive).
APP_OBJS = $(notdir $(patsubst %.c,%.o,$(filter app/%,$(SRCS)))) \
           $(notdir $(patsubst %.c,%.o,$(filter %ncurses.c,$(APP_SRCS))))

# Static libraries (one per layer/sub-layer)
LIBS = $(addprefix lib,$(addsuffix .a,$(LIB_LINK_ORDER)))

LIBFILES = splash.hlp origcmds.hlp owizcmds.hlp roglcmds.hlp \
			rwizcmds.hlp version.hlp welcome.hlp

DOCS = manual.md

moria : $(APP_OBJS) $(LIBS)
	$(CC) -o $(TARGET) $(CFLAGS) $(APP_OBJS) $(LIBS) $(CURSES) $(PTHREAD) $(LFLAGS)

# Build each library from its layer's objects (in src/ directory)
libcommand.a: $(notdir $(LIB_SRCS_command:.c=.o))
	rm -f $@
	$(AR) rcs $@ $^
libworld.a: $(notdir $(LIB_SRCS_world:.c=.o))
	rm -f $@
	$(AR) rcs $@ $^
libui.a: $(notdir $(LIB_SRCS_ui:.c=.o))
	rm -f $@
	$(AR) rcs $@ $^
libplatform.a: $(notdir $(LIB_SRCS_platform:.c=.o))
	rm -f $@
	$(AR) rcs $@ $^
libmodel_player.a: $(notdir $(LIB_SRCS_model_player:.c=.o))
	rm -f $@
	$(AR) rcs $@ $^
libmodel_monster.a: $(notdir $(LIB_SRCS_model_monster:.c=.o))
	rm -f $@
	$(AR) rcs $@ $^
libmodel_dungeon.a: $(notdir $(LIB_SRCS_model_dungeon:.c=.o))
	rm -f $@
	$(AR) rcs $@ $^
libmodel_store.a: $(notdir $(LIB_SRCS_model_store:.c=.o))
	rm -f $@
	$(AR) rcs $@ $^
libmodel_item.a: $(notdir $(LIB_SRCS_model_item:.c=.o))
	rm -f $@
	$(AR) rcs $@ $^
libmodel_base.a: $(notdir $(LIB_SRCS_model_base:.c=.o))
	rm -f $@
	$(AR) rcs $@ $^
libcore.a: $(notdir $(LIB_SRCS_core:.c=.o))
	rm -f $@
	$(AR) rcs $@ $^

# Pattern rule for compiling C source files
# -MMD -MP writes a .d beside each .o listing the headers it included.
%.o: %.c
	$(CC) $(CFLAGS) -MMD -MP -c -o $@ $<

-include $(OBJS:.o=.d)

# you must define BINDIR and LIBDIR before installing
# assumes that BINDIR and LIBDIR exist
install:
	mkdir -p $(BINDIR)
	chmod 755 $(BINDIR)
	cp -f $(TARGET) $(BINDIR)/$(TARGET)
	chmod 4711 $(BINDIR)/$(TARGET)
	mkdir -p $(LIBDIR)
	chmod 711 $(LIBDIR)
	cp -f ../LICENSE $(BINDIR)
	(cd ../data; cp -f $(LIBFILES) $(LIBDIR))
	(cd ../docs; cp -f $(DOCS) $(BINDIR))
	(cd $(LIBDIR); chmod 444 $(LIBFILES))
	(cd $(BINDIR); touch scores.dat; chmod 644 scores.dat)
# If you are short on disk space, or aren't interested in debugging moria.
#	strip $(BINDIR)/moria

clean:
	@rm -r $(OBJS)
	@rm -f $(OBJS:.o=.d)
	@rm -f $(LIBS)
	@rm -f $(TARGET)
	@echo "Compilation files removed!"
