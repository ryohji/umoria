# makefile.test -- 単体テストのビルドと実行
#
# 本体の makefile とは独立している。理由は 2 つ。
#   1. 本体は ncurses を必要とするが、テスト対象のロジック層は必要としない。
#      テストだけを ncurses なしで動かせるようにしておく。
#   2. テストの追加が本体のビルドに影響しないようにする。
#
# 使い方:
#   make -f makefile.test          # 全テストをビルドして実行
#   make -f makefile.test clean

CC = gcc
STD = -std=c17
# 本体（makefile:18-20）に近づけているが、同一ではない。
# 本体にあってここに無いもの:
#   -Wpedantic            本体ヘッダ（externs.h）由来の警告が数百件出て、
#                         テスト自身の問題が埋もれる
#   -Wmissing-prototypes  代役ファイルは本体の宣言（externs.h）を include
#                         しない設計なので、原理的に全代役が警告になる
#   -Wnested-externs      fixture_reset() が関数内 extern でグローバルを
#                         参照する形なので、意図的にこの形を使っている
# これらを外した状態で、テストコード由来の警告は 0 件を保つ。
WARNINGS = -Wall -Wextra -Wno-unused-parameter \
           -Wshadow -Wstrict-prototypes -Wold-style-definition \
           -Wformat=2 -Wwrite-strings
# 以前はここに本体由来の既存警告（非プロトタイプ宣言・const の落ち・
# 文字列リテラルへの書きこみ等、数千件）の抑制を並べていた。本体側の
# 警告解消でどれも 0 件になったので、抑制ごと外した。テスト・本体とも
# この設定で警告 0 件。
CFLAGS = $(STD) $(WARNINGS) -g -Isrc -Itests
TESTDIR = tests
BUILDDIR = $(TESTDIR)/build

# テストは 1 実行形式につき 1 対象モジュール。
# 対象を増やすときは、ここに <name>_test を足し、下に依存関係を書く。
TESTS = distance_test device_chance_test item_ident_test inven_stack_test \
        put_misc3_test haggle_comment_test movement_rate_test \
        stat_bonus_test objdes_test creature_iterator_test save_bool_test \
        options_test messages_test panel_test stores_test store_save_test \
        str_insert_test inventory_test progress_test score_death_test \
        save_state_test player_pos_test hp_table_test \
        calc_hitpoints_test player_light_test burden_test \
        check_strength_test calc_spells_test gain_spells_test \
        spells_known_test object_levels_test missile_serial_test \
        screen_touched_test inven_command_state_test \
        level_exit_test pending_teleport_test input_ended_test \
        running_test command_state_test player_gold_test player_food_test \
        player_display_numbers_test player_mana_test player_hp_test \
        player_level_test player_status_flags_test player_abilities_test \
        player_timed_effects_test player_resting_test player_speed_test \
        player_infra_range_test player_glowing_hands_test \
        player_spells_to_learn_test player_max_depth_test \
        player_hit_die_test player_armour_class_test \
        player_base_to_hit_test player_disarm_test \
        player_saving_throw_test player_race_test player_body_weight_test \
        player_attack_bonuses_test player_search_skill_test \
        player_bio_test player_stealth_test player_class_test \
        monster_turn_test monster_levels_test monster_breeding_test

BINS = $(addprefix $(BUILDDIR)/,$(TESTS))

.PHONY: all clean run
all: run

# 全テストを実行し、1 つでも失敗したら全体を失敗にする。
# グリーン／レッドがひと目でわかることが目的。
run: $(BINS)
	@echo "== running unit tests =="
	@fail=0; for t in $(BINS); do \
		echo "--- $$t ---"; \
		$$t || fail=1; \
	done; \
	echo; \
	if [ $$fail -eq 0 ]; then \
		echo "RESULT: GREEN"; \
	else \
		echo "RESULT: RED"; \
	fi; \
	exit $$fail

$(BUILDDIR):
	@mkdir -p $(BUILDDIR)

# distance() は misc1.c にあるが、misc1.c 全体をリンクすると
# ダンジョン生成や画面表示への依存が芋づるで付いてくる。
# テスト側で対象関数の宣言だけを使い、実装は misc1.c から取りだす。
$(BUILDDIR)/distance_test: $(TESTDIR)/distance_test.c $(TESTDIR)/minunit.h | $(BUILDDIR)
	$(CC) $(CFLAGS) -o $@ $(TESTDIR)/distance_test.c

# 魔法道具の chance 計算は src/device.c に抽出されている。依存は randint()
# だけなので、misc1.c をリンクせずテスト側で randint() を定義して差しかえる
# （リンクシーム）。写しではなく実体を検証している。
$(BUILDDIR)/device_chance_test: $(TESTDIR)/device_chance_test.c src/device.c src/device.h $(TESTDIR)/minunit.h | $(BUILDDIR)
	$(CC) $(CFLAGS) -o $@ $(TESTDIR)/device_chance_test.c src/device.c

# アイテム鑑定時の処理は src/item_ident.c に抽出されている。元の
# potions.c / eat.c / scrolls.c は巨大な switch が画面表示・ダンジョンに
# 依存するのでリンクできないが、item_ident.c は known1_p() / identify() /
# sample() / prt_experience() とグローバルな py / inventory にしか
# 依存しない。判定に使う known1_p() / identify() / sample() は src/desc.c の
# 本物をリンクする。desc.c が参照する定数テーブル（tables.c）とグローバルな
# インベントリ（inventory.c）も本物を使い、py と画面出力だけを
# tests/fixture.c で補う（リンクシーム）。写しではなく実体を検証している。
#
# #41B で insert_str / insert_lnum の実体は src/str_insert.c へ移ったが、この
# 構成は src/str_insert.c を「リンクしない」。desc.c は insert_str を呼ぶが、
# ここで見ているのは鑑定時の経験値と識別フラグで、名前の複数形化は関係しない。
# fixture.c:75 の空の代役を残し、実体は同居させない（同居させると multiple
# definition になる）。名前組み立ての実体を見るのは objdes_test / str_insert_test。
#
# #18-5B で desc.c が持ち物の窓口（inventory_at / inventory_count /
# inventory_set_count）越しに inventory を触るようになったので src/inventory.c を
# 足す（リンカが未解決として挙げた）。#18-5C で実体（inventory[] と 3 つの
# 数え）も treasure.c から inventory.c に移り static になったので、この 1 本が
# 窓口と置き場の両方になった。tests/fixture.c も窓口越しに消す。
$(BUILDDIR)/item_ident_test: $(TESTDIR)/item_ident_test.c $(TESTDIR)/fixture.c \
                             $(TESTDIR)/fixture.h $(TESTDIR)/minunit.h \
                             src/item_ident.c src/item_ident.h \
                             src/desc.c src/tables.c src/treasure.c \
                             src/inventory.c src/progress.c \
                             src/player_level.c src/player_level.h | $(BUILDDIR)
	$(CC) $(CFLAGS) -o $@ $(TESTDIR)/item_ident_test.c \
	    $(TESTDIR)/fixture.c src/item_ident.c src/desc.c src/tables.c src/treasure.c \
	    src/inventory.c src/progress.c \
	    src/player_level.c

# アイテムのスタック可否判定は misc3.c の inven_check_num() と inven_carry() に
# 二重に書かれている（本体のコメントが「must be identical」と明記している）。
# 写しではなく実体を検証したいので misc3.c をそのままリンクする。
#
# misc3.c は 2212 行・6 責務（画面描画・能力値計算・持ち物管理・呪文・戦闘・
# 移動）が同居しているため、リンクすると 57 個の未解決シンボルが芋づるで
# 付いてくる。内訳はリンカに列挙させ、3 つに分けた。
#   本物をリンクできるもの: 定数表（tables.c）、object_ident（treasure.c）、
#     インベントリ（inventory.c）、py と各種テーブル（player.c）、
#     known1_p（desc.c）
#   代役で足りるもの: 画面描画・入力・ダンジョン・モンスター（misc3_stubs.c）
# fixture.c は使わない。py・msg_print・insert_str・prt_experience を
# player.c / misc3.c が本物として持っているので multiple definition になる。
# 代わりに misc3_stubs.c が fixture.h の窓口を提供する。
#
# #41B で insert_str の実体が src/str_insert.c に移ったので、この構成では
# そちらもリンクする（desc.c が呼ぶ。リンカが未解決として挙げた）。
#
# #18-5B7 で misc3.c が持ち物と装備を src/inventory.h / src/equipment.h の窓口
# 越しに引くようになったので、その実体（src/inventory.c）もリンクする。
# #18-5C で配列そのものも inventory.c の static 定義になったので、テスト側
# （inven_stack_test.c と misc3_stubs.c）も窓口越しに読み書きする。
#
# #18-6B5 で misc3.c が居場所を src/player_pos.h の窓口越しに引くように
# なったので src/player_pos.c もリンクする（実体はまだ src/player.c にあり、
# この構成はそれをリンクしているので足場は要らない）。
#
# #18-7-4B1 で misc3.c が「重さに負けているか」の 2 つの答え（weapon_heavy と
# pack_heavy）を src/burden.h の窓口越しに読み書きするようになったので、
# src/burden.c もリンクする。実体はまだ misc3_stubs.c:43,53 にあり、窓口は
# それを指す（ステップ C1 で実体が burden.c の static に移ったら代役を消す）。
# misc3.c をリンクする 6 本の規則すべてに同じ 1 行が要る。
#
# #18-11-4B で misc3.c の teleport() が出口で src/pending_teleport.h の窓口を
# 呼ぶようになったので src/pending_teleport.c もリンクする。**misc3.c を
# リンクする 9 本すべてに同じ 1 行が要る**（この註はその 1 本目にだけ書いて
# ある）。#18-11-4C で実体が pending_teleport.c の static になったので、
# misc3_stubs.c:53 の代役は消した。
#
# #18-11-7B で misc3.c の prt_state() が「繰りかえしの回数」を
# src/command_state.h の窓口越しに読むようになったので src/command_state.c も
# リンクする。**これも misc3.c をリンクする 9 本すべてに同じ 1 行が要る。**
# 実体はまだ src/variable.c にあり、代役 3 個（command_count・default_dir・
# last_command）は misc3_stubs.c にある（#18-11-7C で消す）。
#
# #18-12-7A で src/player_status_flags.c（いまの状態の旗）を足す。**本体の
# 呼び手はまだ 1 つも変えていないが、リンク代は A で先払いする**（#18-12-6A と
# 同じ段どり。B は呼び手の書きかえだけにしたい）。旗を触るファイルは
# misc3.c・moria1.c・moria3.c・moria4.c・creature.c・eat.c・spells.c・
# dungeon.c・misc1.c・save.c の 10 本で、**税が要る規則は 12 本**
# （下調べの予測どおり）。内訳は 2 通りある。
#   9 本: misc3.c をリンクしている（この規則を含む）。
#   3 本: **テスト自身が本体の .c を include している** ——
#     movement_rate_test は creature.c、save_bool_test と store_save_test は
#     save.c（static 関数を呼ぶため実体ごと取りこむ形）。コマンド行に
#     src/creature.c も src/save.c も出てこないので、**リンク行だけを
#     数えると取りこぼす**。
# 残りのファイル（dungeon.c・moria*.c・eat.c・spells.c・misc1.c）は
# どのテストも本物を持ちこんでいない（代役か、そもそも触らない）。
#
# **税は「リンクする側に py があるか」も見なければならない。** 数えまちがえて
# creature_iterator_test と player_food_test にも足してみたら、この module の
# `extern player_type py;` が未解決でリンクが落ちた（前者は src/monsters.c しか
# リンクせず、後者は #18-12-2C で腹の置き場が module に入ったので py を
# 持たない）。どちらも旗を触るファイルを持ちこんでいないので、足す必要も
# 無かった。
# #18-12-8A で src/player_abilities.c（装備で決まる耐性・能力 17 個）を足す。
# **本体の呼び手はまだ 1 つも変えていないが、リンク代は A で先払いする**
# （#18-12-6A・#18-12-7A と同じ段どり）。17 個を触るファイルは moria1.c・
# save.c・creature.c・moria3.c・spells.c・moria2.c・dungeon.c・potions.c の
# 8 本で、**税が要る規則は 3 本**（下調べの予測どおり）—— どれも
# 「テスト自身が本体の .c を include している」形で、movement_rate_test が
# creature.c、save_bool_test と store_save_test が save.c。**参照は 106 あるのに
# 税は 3 本** で、misc3.c を引く 9 本には触らない（この 17 個は画面に出ない）。
# #18-12-7 で税を払った 12 本のうちの 3 本なので、同じ行に 1 本足すだけ。
# #18-12-9A で src/player_timed_effects.c（一時的な状態の数えおとし 18 個）を
# 足す。**呼び手はまだ 1 つも変えていないが、リンク代は A で先払いする**
# （#18-12-6A・#18-12-7A・#18-12-8A と同じ段どり）。18 個を触るファイルは
# 18 本もあるが、**税が要る規則は #18-12-7 とぴったり同じ 12 本** ——
# 数と印は同じ 10 本のファイル（misc3.c・creature.c・save.c ほか）が触るので、
# 税の形も同じになる。だから src/player_status_flags.c が並んでいる行に
# 1 本足すだけでよく、**逆に言えば「旗の税を払っていない規則には数の税も
# 要らない」**（py を持たない creature_iterator_test・player_food_test に
# 足すとリンクが落ちるのも #18-12-7A と同じ理由）。
# #18-12-11A で src/player_speed.c（いまの速さ）を足す。**ここで初めて税が
# 11 本になる** —— #18-12-7 から #18-12-10 までの 12 本のうち、
# **movement_rate_test だけ払わない**。creature.c が触るのはモンスターの
# cspeed で（moves_this_turn() に渡るのも引数）、プレイヤーの py.flags.speed は
# 読まないから。残る 11 本は misc3.c を引く 9 本（prt_speed() と
# prt_stat_block() が読む）と、src/save.c を丸ごと取りこむ save_bool_test・
# store_save_test（24 個の short の 1 つとして読み書きする）。
# #18-12-12A で src/player_infra_range.c（赤外視の届く距離）を足す。**税は
# 12 本に戻るが、9 本ぶんの理由が変わる** —— 11 つめまでは misc3.c（画面）
# だったが、この問いを人物画面に出すのは **src/abilities.c の "%d feet"** で、
# それを引く 9 本は misc3.c を引く 9 本とちょうど同じ顔ぶれ。残る 3 本は
# src/save.c を丸ごと取りこむ save_bool_test・store_save_test と、
# **src/creature.c を丸ごと取りこむ movement_rate_test**（11 つめでは払わなかった
# 1 本が戻ってくる —— creature.c:57 が「赤外視の距離のうちで、しかも温かいか」で
# モンスターが見えるかを決める）。**リンクの税は構造体ではなく問いについてくる**
# （台帳の所見 34）。
# #18-12-13A で src/player_glowing_hands.c（手が光っているか）を足す。**税は
# 3 本に落ちる** —— 12 つめの 12 本のうち **9 本がまるごと外れる**。misc3.c も
# abilities.c もこの蓄えを触らないから（画面にも人物画面にも出ない。光って
# いることを知らせるのは message だけ）。**この 9 本の常連が外れるのはこの列で
# 初めて**で、src/player_glowing_hands.c が並ぶのは残る 3 本 ——
# src/save.c を丸ごと取りこむ save_bool_test・store_save_test（17 バイトの
# 装備の能力のすぐ後ろに 1 バイト書く）と、src/creature.c を丸ごと取りこむ
# movement_rate_test（モンスターに殴られたとき消える）。**moria3.c と
# scrolls.c はどのテストもリンクしない**ので、自分が殴ったときと巻物を
# 読んだときのぶんは税にならない。所見 34 の 3 例めで、**落差はこれまでで最大**。
# #18-12-14A で src/player_spells_to_learn.c（あと何個呪文を覚えられるか）を
# 足す。**税は 11 本に戻り、顔ぶれは 11 つめ（いまの速さ）と同じ** ——
# 13 つめで初めて外れた **misc3.c を引く 9 本がまるごと帰ってくる**
# （`prt_study()` が "Study" を出し、`calc_spells()` と `gain_spells()` が
# 数を作って減らす。3 つとも misc3.c）＋ src/save.c を丸ごと取りこむ
# save_bool_test・store_save_test。**creature.c はこの数を読まないので
# movement_rate_test は払わない**（12・13 つめとの違い）。
# #18-12-16A で src/player_max_depth.c（どこまで潜ったか）を足す。**`struct misc`
# から出る 1 つめで、税はこの列で最小の 2 本** —— src/save.c を丸ごと取りこむ
# save_bool_test と store_save_test だけ（py は src/player.c 本物でリンクして
# いるので足場は要らない）。8 参照のうち残る 6 つは dungeon.c 4・death.c 2 で、
# **どちらのファイルもどのテストも本物を持ちこんでいない**から税にならない。
# 常連の 9 本（misc3.c・abilities.c）が外れるのは 13 つめと同じ理由で、この数は
# 画面にも人物画面にも出ない。
#
# **下調べの予測は 5 本で、外れた。** 数えかたの誤りで、recipe の範囲を
# 「次の recipe の直前まで」と切ったために**後ろの recipe に付いた解説の中の
# `src/save.c` を手前の recipe のものとして数えていた**（item_ident_test・
# creature_iterator_test・player_food_test の 3 本が偽物）。正しくは
# **recipe の行と、その直後のコマンド行だけ**（空行か `#` で切る）。
# #18-12-17 以降の下調べの数字も同じ誤りを含むので、各 A で測りなおす。
$(BUILDDIR)/inven_stack_test: $(TESTDIR)/inven_stack_test.c \
                              $(TESTDIR)/misc3_stubs.c \
                              $(TESTDIR)/fixture.h $(TESTDIR)/minunit.h \
                              src/command_state.c src/misc3.c src/player_display_numbers.c src/player_gold.c src/player_mana.c src/player_mana.h src/player_hp.c src/player_hp.h src/stats.c src/str_insert.c src/desc.c \
                              src/pending_teleport.c src/pending_teleport.h \
                              src/tables.c src/inventory.c \
                              src/treasure.c src/player.c src/abilities.c \
                              src/progress.c src/score_death.c \
                              src/save_state.c \
                              src/player_pos.c src/hp_table.c \
                              src/burden.c src/burden.h \
                              src/spells_known.c src/spells_known.h src/item_ident.c src/item_ident.h \
                            src/object_levels.c src/object_levels.h \
                            src/player_level.c src/player_level.h \
                            src/player_status_flags.c src/player_status_flags.h \
                            src/player_timed_effects.c src/player_timed_effects.h \
                            src/player_resting.c src/player_resting.h \
                            src/player_speed.c src/player_speed.h \
                            src/player_infra_range.c src/player_infra_range.h \
                            src/player_spells_to_learn.c src/player_spells_to_learn.h \
                            src/player_base_to_hit.c src/player_base_to_hit.h \
                            src/player_saving_throw.c src/player_saving_throw.h \
                            src/player_race.c src/player_race.h \
                            src/player_body_weight.c src/player_body_weight.h \
                            src/player_attack_bonuses.c src/player_attack_bonuses.h \
                            src/player_search_skill.c src/player_search_skill.h \
                            src/player_bio.c src/player_bio.h \
                            src/player_stealth.c src/player_stealth.h \
                            src/player_class.c src/player_class.h \
                            src/player_disarm.c src/player_disarm.h | $(BUILDDIR)
	$(CC) $(CFLAGS) -o $@ $(TESTDIR)/inven_stack_test.c \
	    $(TESTDIR)/misc3_stubs.c src/command_state.c src/misc3.c src/player_display_numbers.c src/player_gold.c src/player_mana.c src/player_hp.c src/pending_teleport.c src/stats.c src/str_insert.c \
	    src/desc.c src/tables.c src/inventory.c \
	    src/treasure.c src/player.c src/abilities.c \
	    src/progress.c src/score_death.c src/save_state.c \
	    src/player_pos.c src/hp_table.c src/burden.c src/spells_known.c src/item_ident.c src/object_levels.c \
