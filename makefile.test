# 覚えている呪文の置き場（spell_learned・spell_worked・spell_forgotten・
# spell_order）。#18-8-C で実体が src/spells_known.c の static になったので、
# ステップ A のあいだ要った足場（tests/spells_known_fixture.c）は消えた。
# リンクは対象 1 本＋テスト 1 本の 2 コンパイル単位で足りる
# （progress_test・score_death_test・player_pos_test・hp_table_test・
# player_light_test・burden_test と同じ形）。
$(BUILDDIR)/spells_known_test: $(TESTDIR)/spells_known_test.c \
                        $(TESTDIR)/minunit.h \
                        src/spells_known.c src/spells_known.h | $(BUILDDIR)
	$(CC) $(CFLAGS) -o $@ $(TESTDIR)/spells_known_test.c src/spells_known.c

# 財布の中身。py の 86 個のフィールドのうち、いちばん独立した問いを 1 本目と
# して出したもの（#18-12-1）。**py 全体は module にならない** —— 問いごとに
# 出す方式で、これがその 1 つめ。
#
# #18-12-1C で置き場が src/player_gold.c の static に入り、au が struct misc
# から出たので、リンクは **テスト＋ module の 2 本だけ**になった（足場
# tests/player_gold_fixture.c は消した）。misc3.c・creature.c・save.c を引く
# 12 本が src/player_gold.c をリンクする行はそのまま要る —— 勘定欄・盗人・
# セーブが窓口を呼び、実体はいまその中にある。
$(BUILDDIR)/player_gold_test: $(TESTDIR)/player_gold_test.c \
                              $(TESTDIR)/minunit.h \
                              src/player_gold.c src/player_gold.h | $(BUILDDIR)
	$(CC) $(CFLAGS) -o $@ $(TESTDIR)/player_gold_test.c src/player_gold.c

# 腹の具合（py.flags.food と py.flags.food_digested）。py から出す 2 つめの
# 問い（#18-12-2A）。フィールドは 2 つあるが 1 つの問いに答えている ——
# 数と、その数が 1 ターンで減る速さ。
#
# 実体は #18-12-2C で src/player_food.c の static に入ったので、依存は
# その 1 本だけ（足場 tests/player_food_fixture.c は消した。static に
# したあとも同じ名前を定義する足場を残すと、窓口に届かない別の器が
# 生き残る。HANDOVER 第 7 節）。
$(BUILDDIR)/player_food_test: $(TESTDIR)/player_food_test.c \
                              $(TESTDIR)/minunit.h \
                              src/player_food.c src/player_food.h | $(BUILDDIR)
	$(CC) $(CFLAGS) -o $@ $(TESTDIR)/player_food_test.c src/player_food.c

# 画面に出す 4 つの数（もとの py.misc.dis_th・dis_td・dis_tac・dis_ac）。py から
# 出す 3 つめの問い（#18-12-3）。フィールドは 4 つあるが 1 つの問いに答えて
# いる —— 人物画面に出る「+ To Hit」「+ To Damage」「+ To AC」「Total AC」で、
# **戦いに使う本物の修正（ptohit ほか）とは別の数**。
#
# #18-12-3C で置き場が src/player_display_numbers.c の static に入り、4 つが
# struct misc から出たので、リンクは **テスト＋ module の 2 本だけ**になった
# （足場 tests/player_display_numbers_fixture.c は消した）。misc3.c を引く
# 9 本と src/save.c を丸ごと取りこむ 2 本が src/player_display_numbers.c を
# リンクする行はそのまま要る —— 画面と書きだしとセーブが窓口を呼び、実体は
# いまその中にある。
$(BUILDDIR)/player_display_numbers_test: $(TESTDIR)/player_display_numbers_test.c \
                              $(TESTDIR)/minunit.h \
                              src/player_display_numbers.c src/player_display_numbers.h | $(BUILDDIR)
	$(CC) $(CFLAGS) -o $@ $(TESTDIR)/player_display_numbers_test.c src/player_display_numbers.c

# 魔力（もとの py.misc.cmana・mana・cmana_frac）。py から出す 4 つめの問い
# （#18-12-4A）。フィールドは 3 つあるが 1 つの問いに答えている ——
# 残り・上限・**まだ 1 点に届いていない端数**。端数があるのは再生が 1 ターンに
# 65536 分の数百しか戻さないためで、置く場所が無ければ永久に 1 点も戻らない。
#
# 実体は #18-12-4C で src/player_mana.c の static に入った。足場
# tests/player_mana_fixture.c はそこで消えたので、依存は module 1 本だけ。
$(BUILDDIR)/player_mana_test: $(TESTDIR)/player_mana_test.c \
                              $(TESTDIR)/minunit.h \
                              src/player_mana.c src/player_mana.h | $(BUILDDIR)
	$(CC) $(CFLAGS) -o $@ $(TESTDIR)/player_mana_test.c src/player_mana.c

# 体力（#18-12-5）。魔力と同じ「端数つきの数」だが、負の値が「死んでいる」
# 印を兼ねているところが違う。実体は #18-12-5C で src/player_hp.c の static に
# 入った。足場 tests/player_hp_fixture.c はそこで消えたので、依存は module
# 1 本だけ。
$(BUILDDIR)/player_hp_test: $(TESTDIR)/player_hp_test.c \
                            $(TESTDIR)/minunit.h \
                            src/player_hp.c src/player_hp.h | $(BUILDDIR)
	$(CC) $(CFLAGS) -o $@ $(TESTDIR)/player_hp_test.c src/player_hp.c

# 階級と経験値（#18-12-6）。5 つのフィールド（lev・exp・max_exp・exp_frac・
# expfact）が 1 つの問いに答えるが、そのうち階級だけは「置き場でもあり結論でも
# ある」—— 値段表と係数から決まるのにセーブファイルに書かれ、wizard の細工は
# わざと食いちがわせる。約束を守る道が本体に 2 つ（misc3.c の登りと spells.c の
# 数えなおし）あって、同じ答えになる保証が無かったので、そこに釘を打つ。
#
# A の段では置き場は py.misc のままなので、足場
# tests/player_level_fixture.c が py と値段表 player_exp[] を 1 つずつ置く
# （#18-12-6C で消える）。
$(BUILDDIR)/player_level_test: $(TESTDIR)/player_level_test.c \
                               $(TESTDIR)/player_level_fixture.c \
                               $(TESTDIR)/minunit.h \
                               src/player_level.c src/player_level.h | $(BUILDDIR)
	$(CC) $(CFLAGS) -o $@ $(TESTDIR)/player_level_test.c \
	    $(TESTDIR)/player_level_fixture.c src/player_level.c

# 「いまの状態の旗」（#18-12-7）。py から出す 7 つめの問いで、**フィールドは
# 1 つなのに名前が 31 ある** —— もとは py.flags.status の 1 語を 10 ファイル・
# 105 か所が直に触っていた。ここまでの 6 つと違って答えが数ではなく集合なので、
# テストの重心は「ビットの番号（= セーブファイルの書式）」と「どの窓口も自分の
# ビット以外を触らない」の 2 つ。
#
# #18-12-7C で 1 語が src/player_status_flags.c の static に入ったので、足場は
# 要らなくなった（A・B の段では tests/player_status_flags_fixture.c が py を
# 置いていた）。**リンクするのは本体 1 つだけ** —— この形が 7 回めになる。
$(BUILDDIR)/player_status_flags_test: $(TESTDIR)/player_status_flags_test.c \
                                     $(TESTDIR)/minunit.h \
                                     src/player_status_flags.c \
                                     src/player_status_flags.h | $(BUILDDIR)
	$(CC) $(CFLAGS) -o $@ $(TESTDIR)/player_status_flags_test.c \
	    src/player_status_flags.c

# 「装備で決まる耐性・能力」（#18-12-8）。py から出す 8 つめの問いで、**17 個の
# フィールドが 1 つの問いに答える** —— もとは py.flags.see_inv から
# py.flags.sustain_chr までを 8 ファイル・106 か所が直に触っていた。ここまでの
# 7 つと違って**答えは覚えてあるのではなく装備から毎回作りなおされる**ので、
# テストの重心は「セーブファイルの 17 バイトの並び」「どの窓口も自分の 1 個
#以外を触らない」「能力値の並びが品物側とゲーム側で 2 つあり 4 番と 5 番が
# 入れちがっている」の 3 つ。
#
# #18-12-8C で置き場が module の中に入ったので、足場
# tests/player_abilities_fixture.c（py を 1 つ置いていた）は消えた。**この規則が
# 引くのは窓口 1 本だけ** —— #18-12-1C から 8 回続けて同じ形。
$(BUILDDIR)/player_abilities_test: $(TESTDIR)/player_abilities_test.c \
                                   $(TESTDIR)/minunit.h \
                                   src/player_abilities.c \
                                   src/player_abilities.h | $(BUILDDIR)
	$(CC) $(CFLAGS) -o $@ $(TESTDIR)/player_abilities_test.c \
	    src/player_abilities.c

# 「一時的な状態の数えおとし」（#18-12-9）。py から出す 9 つめの問いで、**18 個の
# フィールドが 1 つの問いに答える** —— py.flags.blind から py.flags.tim_infra
# までを 18 ファイル・281 か所が直に触っている（dungeon.c が 75、save.c が 38、
# creature.c が 32）。
#
# **この規則がこれまでと違うのは、リンクするのが 2 本あること。** 印
# （player_status_flags.c の族 1）と数は 1 つの事実の両半分で、12 個の印が数と
# 対になっている。**module が別の module を呼ぶのはこれが 1 例め**で、テストも
# 両方を引いて「始まりで印が立ち、数え切りで印が下りる」を本物どうしで見る
# （代役を置くと肝心の対応表が検証できない）。
#
# #18-12-9C で置き場が module の static に入ったので、py を置く足場
# tests/player_timed_effects_fixture.c は消えた（#18-12-1C から 9 回めの同じ形）。
# 残るのは本物 2 本だけ。
$(BUILDDIR)/player_timed_effects_test: $(TESTDIR)/player_timed_effects_test.c \
                                       $(TESTDIR)/minunit.h \
                                       src/player_timed_effects.c \
                                       src/player_timed_effects.h \
                                       src/player_status_flags.c \
                                       src/player_status_flags.h | $(BUILDDIR)
	$(CC) $(CFLAGS) -o $@ $(TESTDIR)/player_timed_effects_test.c \
	    src/player_timed_effects.c src/player_status_flags.c

# 「休んでいるか、あと何ターン」（#18-12-10）。py から出す 10 つめの問いで、
# **1 個のフィールドが 5 ファイル・21 か所から触られている**（dungeon.c が 12、
# creature.c が 3、moria1.c が 3、misc3.c が 2、save.c が 2）。
#
# **9 つめとは逆で、リンクするのは本体 1 本だけ。** 数（この module）は族 3 の
# 印 PY_REST と対だが、並んで書かれているのは moria1.c の 2 か所の隣りあう
# 2 行だけなので、**畳まずに印の呼び手をそのまま残した**（src/player_resting.h）。
# だから player_status_flags.c は引かない。
#
# #18-12-10C で置き場が module の static に入ったので、py を置く足場
# tests/player_resting_fixture.c は消えた（#18-12-1C から 10 回めの同じ形）。
# **リンクするのは本体 1 本だけ。**
$(BUILDDIR)/player_resting_test: $(TESTDIR)/player_resting_test.c \
                                 $(TESTDIR)/minunit.h \
                                 src/player_resting.c \
                                 src/player_resting.h | $(BUILDDIR)
	$(CC) $(CFLAGS) -o $@ $(TESTDIR)/player_resting_test.c \
	    src/player_resting.c

# 「いまの速さ」（#18-12-11）。py から出す 11 つめの問いで、**1 個の
# フィールドが 5 ファイル・9 か所から触られている**（dungeon.c が 3、misc3.c が
# 2、save.c が 2、misc1.c が 1、moria1.c が 1）。
#
# **10 つめと同じで、リンクするのは本体 1 本＋足場 1 本。** 探索の 1 段引きは
# 状態の旗（族 3）の側にあるが、速さと探索は 1 つの事実の両半分ではないので
# 畳まず、player_status_flags.c は引かない（src/player_speed.h）。モンスターの
# cspeed を回すループも misc1.c の作りだしも呼び手に残るので、creature.c も
# misc1.c も要らない。
#
# #18-12-11C で置き場が module の static に入ったので、py を置く足場
# tests/player_speed_fixture.c は消えた（#18-12-1C から 11 回めの同じ形）。
# **リンクするのは本体 1 本だけ。**
$(BUILDDIR)/player_speed_test: $(TESTDIR)/player_speed_test.c \
                               $(TESTDIR)/minunit.h \
                               src/player_speed.c \
                               src/player_speed.h | $(BUILDDIR)
	$(CC) $(CFLAGS) -o $@ $(TESTDIR)/player_speed_test.c \
	    src/player_speed.c

# 「赤外視の届く距離」（#18-12-12）。py から出す 12 つめの問いで、**1 個の
# フィールドが 6 ファイル・9 か所から触られている**（creature.c が 2、dungeon.c が
# 2、save.c が 2、abilities.c が 1、create.c が 1、moria1.c が 1）。
#
# **リンクするのは本体 1 本＋足場 1 本。** 薬のターン数は player_timed_effects.c
# の別の問いで、±1 を足し引きするのは呼び手の dungeon.c なので引かない。
# 「そのモンスターが温かいか（CD_INFRA）」は creature.c に、フィートへの
# 10 倍は abilities.c に残るので、どちらも要らない（src/player_infra_range.h）。
#
# #18-12-12C で置き場が module の static に入ったので、py を置く足場
# tests/player_infra_range_fixture.c は消えた（#18-12-1C から 12 回めの同じ形）。
# **リンクするのは本体 1 本だけ。**
$(BUILDDIR)/player_infra_range_test: $(TESTDIR)/player_infra_range_test.c \
                                     $(TESTDIR)/minunit.h \
                                     src/player_infra_range.c \
                                     src/player_infra_range.h | $(BUILDDIR)
	$(CC) $(CFLAGS) -o $@ $(TESTDIR)/player_infra_range_test.c \
	    src/player_infra_range.c

# 「手が光っているか」（#18-12-13）。py から出す 13 つめの問いで、**1 バイトが
# 4 ファイル・8 か所から触られている**（creature.c が 2、moria3.c が 2、
# save.c が 2、scrolls.c が 2）。
#
# **module の名前がフィールド名と違う。** externs.h:538 に
# `int confuse_monster(int, int, int);`（src/spells.c の呪文）があって名前が
# 衝突するので、game の message に合わせて「手」を名前にした
# （src/player_glowing_hands.h）。
#
# **リンクするのは本体 1 本だけ。** 相手が混乱するかの判定は creature.c と
# moria3.c に、message は呼び手に、鑑定の成否は scrolls.c に残るので、どれも
# 要らない。
#
# #18-12-13C で置き場が module の static に入ったので、py を置く足場
# tests/player_glowing_hands_fixture.c は消えた（#18-12-1C から 13 回めの
# 同じ形）。
$(BUILDDIR)/player_glowing_hands_test: $(TESTDIR)/player_glowing_hands_test.c \
                                       $(TESTDIR)/minunit.h \
                                       src/player_glowing_hands.c \
                                       src/player_glowing_hands.h | $(BUILDDIR)
	$(CC) $(CFLAGS) -o $@ $(TESTDIR)/player_glowing_hands_test.c \
	    src/player_glowing_hands.c

# 「あと何個呪文を覚えられるか」（#18-12-14）。py から出す 14 つめの問いで、
# **1 バイトが 2 ファイル・9 か所から触られている**（misc3.c が 7、save.c が 2）。
# **`struct flags` から出る最後の「問い」。**
#
# **module の名前がフィールド名と違う。** `new_spells` は「新しい呪文」と
# 読めるが、これは呪文ではなく数（どの呪文を覚えているかは src/spells_known.c）。
# この module より前に書かれた tests/gain_spells_test.c がすでに
# `spells_to_learn` と呼んでいたので、それに合わせた。
#
# **リンクするのは本体 1 本だけ**（#18-12-14C で足場が消えた）。9 式の許される数と
# 本が足りない差は misc3.c に、message 3 つは呼び手に、PY_STUDY の書きなおしは
# src/player_status_flags.c に残るので、どれも要らない。
$(BUILDDIR)/player_spells_to_learn_test: $(TESTDIR)/player_spells_to_learn_test.c \
                                         $(TESTDIR)/minunit.h \
                                         src/player_spells_to_learn.c \
                                         src/player_spells_to_learn.h | $(BUILDDIR)
	$(CC) $(CFLAGS) -o $@ $(TESTDIR)/player_spells_to_learn_test.c \
	    src/player_spells_to_learn.c

# 「どこまで潜ったか」（#18-12-16）。py から出す 15 つめの問いで、
# **`struct misc` から出る 1 つめ**。1 つの short が 3 ファイル・8 か所から
# 触られている（dungeon.c が 4、death.c が 2、save.c が 2）。
#
# **これまでの 14 問と違って、体でも腕でもなく「どこに行ったか」の記録。**
# 単位は迷宮の階（dun_level と同じ）で町が 0 階、そして**この数は減らない**。
#
# **#18-12-16C で足場は消えた**（15 回続けて同じ形）。リンクするのは本体 1 つだけ。
# 得点の 1 階 100 点は death.c に、帰還の巻物の引きずり下ろしは dungeon.c に、
# セーブの位置は save.c に残るので、どれも要らない。
$(BUILDDIR)/player_max_depth_test: $(TESTDIR)/player_max_depth_test.c \
                                   $(TESTDIR)/minunit.h \
                                   src/player_max_depth.c \
                                   src/player_max_depth.h | $(BUILDDIR)
	$(CC) $(CFLAGS) -o $@ $(TESTDIR)/player_max_depth_test.c \
	    src/player_max_depth.c

# 「体力の骰子は何面か」（#18-12-17）。py から出す 16 つめの問いで、
# **`struct misc` から出る 2 つめ**。1 バイトが 3 ファイル・9 か所から
# 名ざされている（create.c が 7、save.c が 2、player.c が 1 —— ただし
# player.c のはコメント）。
#
# **単位は面の数**で、種族の土台（6〜12）に階級ぶん（0〜9）を足して
# 人物を作るときに 1 度決まり、そのあと二度と動かない。
# **遊んでいる間は誰も読まない** —— 読み手 5 つはぜんぶ create.c の
# 体力を振る 20 行の中。
#
# **#18-12-17C で足場は消えた**（16 回続けて同じ形）。リンクするのは本体 1 つだけ。
# 体力そのものは player_hp.c に、振りなおしの下限上限は create.c に、
# 体力表は hp_table.c に、2 つの表は player.c に残るので、どれも要らない。
$(BUILDDIR)/player_hit_die_test: $(TESTDIR)/player_hit_die_test.c \
                                 $(TESTDIR)/minunit.h \
                                 src/player_hit_die.c \
                                 src/player_hit_die.h | $(BUILDDIR)
	$(CC) $(CFLAGS) -o $@ $(TESTDIR)/player_hit_die_test.c \
	    src/player_hit_die.c

# 「守りの点数はいくつか」（17 つめの問い・`struct misc` から出る 3 つめ）。
#
# **#18-12-18C で足場は消えた**（17 回続けて同じ形）。リンクするのは本体 1 つだけ。
# **半分が 2 つあるので置き場も 2 つ**だが、どちらも
# src/player_armour_class.c の static。
#
# 当たり判定（misc1.c の test_hit）・打撃の減りかた（creature.c）・
# 画面に出る数（player_display_numbers.c）・呪文の時計
# （player_timed_effects.c）はどれもこの module の外なので、リンクしない。
$(BUILDDIR)/player_armour_class_test: $(TESTDIR)/player_armour_class_test.c \
                                      $(TESTDIR)/minunit.h \
                                      src/player_armour_class.c \
                                      src/player_armour_class.h | $(BUILDDIR)
	$(CC) $(CFLAGS) -o $@ $(TESTDIR)/player_armour_class_test.c \
	    src/player_armour_class.c

# 「素の命中力はいくつか」（18 つめの問い・`struct misc` から出る 4 つめ）。
#
# **#18-12-19C で足場は消えた**（18 回続けて同じ形）。リンクするのは本体 1 つだけ。
# **答えが 2 つあるので置き場も 2 つ**だが、どちらも
# src/player_base_to_hit.c の static。
#
# **答えが 2 つある問い** —— 振るときの数と射るときの数で、読み手はぜんぶ
# 片方だけを読む。1 つの module なのは書きかたが共有されているから
# （呪文はどれも両方を同じだけ動かす。player_base_to_hit.h）。
#
# 当たり判定（misc1.c の test_hit）・人物画面の等級（abilities.c と likert）・
# 素手と暗がりの直し（moria3.c）・投げるときの 75 パーセント（moria4.c）・
# 呪文の時計（player_timed_effects.c）はどれもこの module の外なので、
# リンクしない。
$(BUILDDIR)/player_base_to_hit_test: $(TESTDIR)/player_base_to_hit_test.c \
                                     $(TESTDIR)/minunit.h \
                                     src/player_base_to_hit.c \
                                     src/player_base_to_hit.h | $(BUILDDIR)
	$(CC) $(CFLAGS) -o $@ $(TESTDIR)/player_base_to_hit_test.c \
	    src/player_base_to_hit.c

# 「罠と鍵をはずす腕はいくつか」（19 つめの問い・`struct misc` から出る 5 つめ）。
#
# **#18-12-20C で足場（player_disarm_fixture.c）は消えた** —— 置き場が
# src/player_disarm.c の static に入ったので、py の実体はもう要らない
# （19 回続けて同じ形）。この test がリンクするのは module 1 本だけ。
#
# **1 フィールド 1 つの答えで、この道でいちばん素直な形**（16 つめと同じ）。
# 窓口は 3 本 —— 読み・置く（種族とセーブと wizard で 1 本）・階級ぶんを足す。
#
# 罠と鍵の判定そのもの・暗がりと混乱と幻覚の 10 分の 1（moria4.c）・
# 人物画面の等級（abilities.c と likert）・**4 か所に写してある合計の式**は
# どれもこの module の外なので、リンクしない。合計の式を畳むのは
# `class_level_adj[pclass]` を引くため #18-12-28 待ち（player_disarm.h）。
$(BUILDDIR)/player_disarm_test: $(TESTDIR)/player_disarm_test.c \
                                $(TESTDIR)/minunit.h \
                                src/player_disarm.c \
                                src/player_disarm.h | $(BUILDDIR)
	$(CC) $(CFLAGS) -o $@ $(TESTDIR)/player_disarm_test.c \
	    src/player_disarm.c

# 「抵抗はいくつか」（20 つめの問い・`struct misc` から出る 6 つめ）。
#
# **足場は #18-12-21C で消えた**（20 回続けて同じ形）—— 置き場が
# src/player_saving_throw.c の static になったので、py の実体は要らない。
#
# **1 フィールド 1 つの答えで、19 つめと同じ素直な形**。窓口は 3 本 ——
# 読み・置く（種族とセーブと wizard で 1 本）・階級ぶんを足す。
# 創成時に焼きこむ下駄が無いぶん、19 つめよりさらに素直。
#
# **1 つの数から等級が 2 つ出る**（抵抗は A_WIS と CLA_SAVE、道具を使う腕は
# A_INT と CLA_DEVICE）が、**どちらの等級もこの module の外**。判定そのもの
# （misc3.c の player_saves）・杖と魔法棒の成功率（device.c の
# device_use_chance）・人物画面の等級（abilities.c と likert）・
# **5 か所に写してある合計の式**もぜんぶ外なので、リンクしない。
# 合計の式を畳むのは `class_level_adj[pclass]` を引くため #18-12-28 待ち
# （player_saving_throw.h。所見 42 の 2 例め）。
$(BUILDDIR)/player_saving_throw_test: $(TESTDIR)/player_saving_throw_test.c \
                                      $(TESTDIR)/minunit.h \
                                      src/player_saving_throw.c \
                                      src/player_saving_throw.h | $(BUILDDIR)
	$(CC) $(CFLAGS) -o $@ $(TESTDIR)/player_saving_throw_test.c \
	    src/player_saving_throw.c

# 「どの種族か」（21 つめの問い・`struct misc` から出る 7 つめ）。
#
# **この足場（player_race_fixture.c）は C でも消えない。** 2 つのものを持って
# いて、py の器は #18-12-22C で消えるが **race[] の表は残る** —— 表は
# externs.h の定数表 20 個の 1 つで #18 の対象外なので module の中に入れず、
# src/player_race.c が extern 1 行で引く（先例 src/player_level.c:40 の
# player_exp[]。その足場 tests/player_level_fixture.c も表だけを残している）。
# **16 つめから 21 つめまでの 6 つは足場ごと消えていたので、これが最初の例外。**
#
# **この問いは「数」ではない** —— 中身は race[] の行番号 0〜7 で、13 か所
# ぜんぶが添字かそのまま渡すバイト。だから窓口は 3 本で **`_adjust` は無い**
# （読み・置く・名前）。人物はドワーフに「なっていく」ものではない。
#
# **名前を返す 1 本だけが表に届く。** 店の値段（rgold_adj の列）・生い立ちの
# 表の始まり（prace * 3 + 1）・種族の行そのもの（年齢・身長・選べる階級）は
# どれも module の外なので、リンクするのは module 1 本と足場 1 本だけ。
$(BUILDDIR)/player_race_test: $(TESTDIR)/player_race_test.c \
                              $(TESTDIR)/minunit.h \
                              $(TESTDIR)/player_race_fixture.c \
                              src/player_race.c \
                              src/player_race.h | $(BUILDDIR)
	$(CC) $(CFLAGS) -o $@ $(TESTDIR)/player_race_test.c \
	    $(TESTDIR)/player_race_fixture.c \
	    src/player_race.c

# 「体の重さ」（22 つめの問い・`struct misc` から出る 8 つめ）。
#
# **窓口は 2 本だけで、この道で初めて 3 本を下回る**（読み 8・置く 4）。
# **数なのに誰も足さないので `_adjust` が無い** —— 食べても荷を負っても
# 体重は動かない（人物は太らない）。21 つめは「数でないから」足す窓口が
# 無かったので、理由が違う 2 例めになる。
#
# **足場は #18-12-23C で消えた**（player_body_weight_fixture.c）——
# 21 つめと違ってこの問いは定数表に届かない（創成のほうが race[] の重さの列を
# 読んで、できた数を窓口に渡す）ので、20 回続いた「足場ごと消える」形に戻った。
# **この recipe は module 1 本だけをリンクする** —— 足場も代役も無い最小の形で、
# player_disarm_test・player_saving_throw_test と同じ。
#
# 持てる重さの上限（misc3.c:942。主語は腕力）・盾での打ちかかりと扉への
# 体当たりの 3 つの式（moria4.c。割る数が /10・/60・/2 と違う）・画面と
# 持ち出しファイルの見せかたはどれも module の外。
$(BUILDDIR)/player_body_weight_test: $(TESTDIR)/player_body_weight_test.c \
                              $(TESTDIR)/minunit.h \
                              src/player_body_weight.c \
                              src/player_body_weight.h | $(BUILDDIR)
	$(CC) $(CFLAGS) -o $@ $(TESTDIR)/player_body_weight_test.c \
	    src/player_body_weight.c

# 「命中と打撃の下駄」（23 つめの問い・`struct misc` から出る 9 つめ）。
#
# **2 つのフィールドで答えも 2 つ**（18 つめの pac + ptoac は 26 か所ぜんぶが
# 和だったので答えは 1 つだった）。それでも module は 1 つ —— **置く側が
# 4 か所とも 2 行で対になっている**から（19 つめの bth + bthb と同じ形）。
#
# **窓口は 5 本**（読み 2・対で置く 1・足す 2）。下調べは 6 本と見こんだが、
# 置く窓口は 1 本で足りた。**足すのが 2 本なのは装備の輪が弓のときだけ打撃を
# 飛ばすから** —— 対では呼べない。22 つめ（体の重さ）が「誰も足さない」側の
# 例だったので、隣りあう 2 単位で所見 45 の両側が並ぶ。
#
# **足場は #18-12-24C で消えた**（player_attack_bonuses_fixture.c。置き場が
# module の static 2 つになったので人物の器が要らない。A の 3 行が消えて、
# module 1 本だけをリンクする最小の形 —— player_disarm_test・
# player_saving_throw_test・player_body_weight_test と同じ）。
#
# 数のもと（stats.c の補正表と装備の tohit / todam）・人物画面の等級
# （abilities.c が BTH_PLUS_ADJ を掛ける）・画面に見せる双子
# （player_display_numbers.c）・作りなおす時機（calc_bonuses()）は module の外。
$(BUILDDIR)/player_attack_bonuses_test: $(TESTDIR)/player_attack_bonuses_test.c \
                              $(TESTDIR)/minunit.h \
                              src/player_attack_bonuses.c \
                              src/player_attack_bonuses.h | $(BUILDDIR)
	$(CC) $(CFLAGS) -o $@ $(TESTDIR)/player_attack_bonuses_test.c \
	    src/player_attack_bonuses.c

# 「どれくらい探すか」（24 つめの問い・`struct misc` から出る 10 つめ）。
#
# **2 つのフィールドで答えも 2 つ**で、**和を読む者が 1 人もいない** ——
# fos が「今回見るか」を、srh が「見たら見つかるか」を決める。それでも
# module は 1 つ（階級の表と探索つきの装備がいつも両方を動かす → 所見 40）。
#
# **窓口は 5 本で、23 つめの裏返し** —— 読み 2・**置く 2**・**対で足す 1**。
# **置くのが 2 本なのは wizard.c:173 が srh だけを置くから**（デバッグの
# 入り口は Gold → Searching → Stealth で fos を訊く行が無い）。
# **足すのが 1 本なのは、足す 2 か所がどちらも必ず両方を動かすから。**
# 符号は呼び手が書く（py_bonuses() は (amount, -amount)、創成は (msrh, mfos)
# でどちらも正）。
#
# **足場は #18-12-25C で消えた**（player_search_skill_fixture.c。置き場が
# module の static 2 つになったので人物の器が要らない。**#18-12-1C から
# 数えて 23 回め**の同じ形で、例外は 21 つめだけ）。**module 1 本だけを
# リンクする最小の形** —— player_disarm_test・player_saving_throw_test・
# player_body_weight_test・player_attack_bonuses_test と同じ。
#
# 数のもと（種族と階級の表・装備）・人物画面の逆さ（abilities.c:51 の
# 40 - fos と 0 の留め）・今回見るかの判断（randint() と探索モードの旗）・
# 見て何が見つかるか（search()）はどれも module の外。
$(BUILDDIR)/player_search_skill_test: $(TESTDIR)/player_search_skill_test.c \
                              $(TESTDIR)/minunit.h \
                              src/player_search_skill.c \
                              src/player_search_skill.h | $(BUILDDIR)
	$(CC) $(CFLAGS) -o $@ $(TESTDIR)/player_search_skill_test.c \
	    src/player_search_skill.c

# 「人物の身上書き」（25 つめの問い・`struct misc` から出る 11 つめ）。
#
# **6 フィールドが一度に出る**（`name`・`male`・`age`・`ht`・`sc`・`history`。
# これまでの最多は 5 つの #18-12-6）。**6 つの答えで module は 1 つ** ——
# 束ねる規準（片方だけを読む場所があるか）では割れない（6 つとも別々に読まれ、
# 2 つを足したり比べたりする場所は 1 つも無い）。それでも 1 本にするのは、
# **創成が一度置いたら誰も動かさない**（だから `_adjust` の窓口が 1 本も無い）
# ことと、**訊く者が同じ 4 か所に集まっている**（人物画面・持ち出しファイル・
# セーブの書きと読み）ことから。
#
# **窓口は 13 本**（これまでの最多は 18 つめの 7 本）—— 読み 6・置く 6・消す 1。
#
# **生い立ちの置き場を 1 バイト広げた**（`char [4][60]` → `[4][61]`。
# 60 字ちょうどの行に終端が入らなかった。B21 は到達しないので壊れてはいなかった
# が、窓口の約束（60 字 ＋ 終端）を 60 バイトの行では書けない）。
#
# **足場は #18-12-26C で消えた**（player_bio_fixture.c。置き場が module の
# static 6 つになったので人物の器が要らない。**#18-12-1C から数えて 24 回め**の
# 同じ形で、例外は 21 つめだけ）。**module 1 本だけをリンクする最小の形** ——
# player_disarm_test・player_saving_throw_test・player_body_weight_test・
# player_attack_bonuses_test・player_search_skill_test と同じ。
#
# 王か女王か（3 か所・3 通りの語）・最初の持ち金の +50・どちらの身長の表を
# 引くか・生い立ちの 60 字の折りかえし・画面の並びはどれも module の外。
$(BUILDDIR)/player_bio_test: $(TESTDIR)/player_bio_test.c \
                              $(TESTDIR)/minunit.h \
                              src/player_bio.c \
                              src/player_bio.h | $(BUILDDIR)
	$(CC) $(CFLAGS) -o $@ $(TESTDIR)/player_bio_test.c \
	    src/player_bio.c

# 「足音はどれくらい静かか」（26 つめの問い・`struct misc` から出る 12 つめ）。
#
# **1 フィールド 1 つの答えで、この道でいちばん素直な形**。25 つめが 6 つの
# 答えを一度に出したあとの、いちばん小さな単位（**呼びは 9**。前の単位は 44）。
# **残るフィールドは `pclass` 1 つだけ**（#18-12-28）。
#
# **窓口は 3 本** —— 読み 1 本（4 呼び）・置く 1 本（3 呼び）・足す 1 本（2 呼び）。
# 足すのが要るのは 2 か所だけで、どちらも `+=` だった（創成の階級ぶんと装備）。
#
# **単位は「割る回数」で割合ではない** —— 遊びの中で使うのは creature.c:1576 の
# `notice³ <= (1L << (29 - stl))` 1 か所だけで、**1 点ごとに気づかれる見こみが
# 半分になる**。幅は -1〜18（種族 -2〜+4 ＋ 階級 +1〜+5 ＋ 装備 3 か所 × 1〜3）で、
# **wizard 画面の「(-1-18)」とぴったり同じ**。ずらしの余裕もちょうど使いきって
# いる（-1 で `1L << 30` = 1024³）。
#
# **足場は #18-12-27C で消えた**（player_stealth_fixture.c。置き場が module の
# static になったので人物の器が要らない。**#18-12-1C から数えて 24 回め**の
# 同じ形で、例外は 6 つめと 21 つめ）。**module 1 本だけをリンクする最小の形** ——
# player_disarm_test・player_saving_throw_test・player_body_weight_test・
# player_attack_bonuses_test・player_search_skill_test・player_bio_test と同じ。
#
# 寝ている者が動くかの判定・画面の +1 と等級・装備の符号・-1〜18 の囲い・
# TR_AGGRAVATE はどれも module の外。
$(BUILDDIR)/player_stealth_test: $(TESTDIR)/player_stealth_test.c \
                              $(TESTDIR)/minunit.h \
                              src/player_stealth.c \
                              src/player_stealth.h | $(BUILDDIR)
	$(CC) $(CFLAGS) -o $@ $(TESTDIR)/player_stealth_test.c \
	    src/player_stealth.c

# 「どの階級か」（**27 つめで最後の問い**・`struct misc` から出る 13 つめ）。
#
# **足場（player_class_fixture.c）は 2 つのものを持っていて、#18-12-28C で
# 片方だけが消えた** —— 21 つめ（どの種族か）とまったく同じ形で、この道で
# 3 例め（6 つめ・21 つめに続く）。py の器は C で消えたが **class[] の表は残る**（externs.h の
# 定数表 20 個の 1 つで #18 の対象外。src/player_class.c が extern 1 行で引く。
# 先例は src/player_race.c の race[] と src/player_level.c の player_exp[]）。
# **#18-12-1C から 24 回あった「足場ごと消える」形の、3 つめの例外。**
#
# **この問いは「数」ではない**（21 つめと同じ）—— 中身は class[] の行番号
# 0〜5 で、55 か所ぜんぶが添字かそのまま渡すバイト。だから窓口は 4 本で
# **`_adjust` は無く、これからも無い**（人物はローグに「なっていく」もので
# はない）。**呼び 55 はこの道でいちばん多い**（前の最多は 25 つめの 44）——
# 答えが難しいからではなく、**この 1 バイトで引く定数表が 4 枚あるから**。
#
# **表に届く窓口は 2 本**（`player_class_title()` と
# `player_class_spell_type()`）。class_level_adj の 16 か所（所見 42 の借りは
# 解禁するだけで畳まない）・magic_spell の 10 か所（`- 1` は表の並びの知識）・
# 階級が何をくれるか・階層ごとの称号・持ちものの初期値・得点表の `.class` は
# どれも外なので、**リンクするのは module 1 本と足場 1 本だけ**
# （player_race_test と同じ形）。
#
# **税は 11 本で、常連 11 本そのまま**（src/misc3.c を引く 9 本 ＋ src/save.c を
# 丸ごと #include する 2 本）。**下調べは 15 本と書いていたが、上の 253 行の
# 数えかたの間違いを 3 度め踏んでいた** —— item_ident_test・
# creature_iterator_test・player_food_test・player_infra_range_test は
# **どれも abilities.c / save.c / spells.c をリンクしていない**（すぐ後ろの
# recipe の解説がその名前を出しているだけ）。→ 台帳の所見 48。
$(BUILDDIR)/player_class_test: $(TESTDIR)/player_class_test.c \
                              $(TESTDIR)/minunit.h \
                              $(TESTDIR)/player_class_fixture.c \
                              src/player_class.c \
                              src/player_class.h | $(BUILDDIR)
	$(CC) $(CFLAGS) -o $@ $(TESTDIR)/player_class_test.c \
	    $(TESTDIR)/player_class_fixture.c \
	    src/player_class.c

# 「いま誰の手番か」（ダンジョンとその中身から出す 1 つめの問い・#18-14-1）。
# もとは variable.c:39 の `hack_monptr` で、**1 つの int が 1 つの問いにしか
# 答えていない**のに、読み手 2 つ（misc1.c の詰めなおしと moria3.c の死）が
# `hack_monptr < i` と手で書いていた。窓口はその比較に名前を付ける。
#
# **リンクするのは module 1 本だけ**で、**A の段から足場が 1 つも要らない**
# —— 依存は MIN_MONIX（constant.h）すら使わず、int 1 つと比較 1 つで足りる。
# 置き場を最初から static にしたので、**#18-12-1C から続く「module 1 本」の
# 最小形に 1 歩めから入る**（str_insert.c・missile_serial.c・screen_touched.c
# と同じ 2 コンパイル単位）。これまでの単位は A では置き場がまだ variable.c
# か py にあり、足場（tests/*_fixture.c）で器を 1 つ置いてから C で捨てて
# いた。
#
# **そのぶん A のあいだは器が 2 つあった** —— variable.c:39 の `hack_monptr`
# （本体が使っていた）と、この module の static（テストだけが見ていた）。
# 食いちがう心配が無かったのは、**A の段では本体が窓口を 1 つも呼んで
# いない**から（A は保護だけ）。B で creature.c の 10 の代入・misc1.c と
# moria3.c の比較・game_state.c の写しとりを窓口に差しかえたところで
# **置き場の引っこしも済み**（呼び手が窓口を通れば触る器はこちら）、
# C は variable.c と externs.h から古い 1 行を消すだけで終わった。
#
# **B で増えた recipe は 1 本だけ** —— movement_rate_test（src/creature.c を
# 丸ごと #include する）。窓口を呼ぶのは 4 ファイル（creature.c 10 か所・
# misc1.c 1・moria3.c 1・game_state.c 1）だが、**残る 3 本はどの recipe にも
# 出てこない**。この道でいちばん安い税で、所見 34 の「税は構造体ではなく問いに
# ついてくる」の別の面 —— **触る数ではなく、テストが本物を持ちこんでいるかで
# 決まる**。
$(BUILDDIR)/monster_turn_test: $(TESTDIR)/monster_turn_test.c \
                              $(TESTDIR)/minunit.h \
                              src/monster_turn.c \
                              src/monster_turn.h | $(BUILDDIR)
	$(CC) $(CFLAGS) -o $@ $(TESTDIR)/monster_turn_test.c \
	    src/monster_turn.c

# レベルごとのモンスター定義の索引（ダンジョンとその中身から出す 2 つめの
# 問い・#18-14-2）。もとは monsters.c:765 の `int16_t m_level[41];` で、
# **組みたてる側が main.c の static な init_m_level() にあった** ——
# main.c は main() を持つのでテストからリンクできず、**数え上げには 1 本の
# テストも届いていなかった**（#18-10 の init_t_level() と同じ形。あちらは
# object_levels.c に移して初めて届いた）。
#
# **リンクするのは module 1 本と src/monsters.c だけ。** 索引は表を数えて
# 作るものなので、**本物の表（279 体）を持ちこむのがこのテストの要**：
# 帯の中身が本当にそのレベルかを確かめるには定義そのものが要る。
# creature_iterator_test と同じ 2 ファイルの形で、足場（tests/*_fixture.c）は
# 1 つも要らない。
#
# monsters.c は `is_a_vowel()` を 1 か所から呼ぶ（monster_name_indefinite()）。
# 名前を 1 件も見ないので、テスト側で代役を 1 行書いて済ませる
# （creature_iterator_test・save_stubs.c と同じ）。
#
# **A のあいだは器が 2 つある** —— monsters.c:765 の `m_level`（本体が使う）と
# この module の static（テストだけが見る）。#18-14-1A と同じで、本体が窓口を
# 1 つも呼んでいないから食いちがわない。**他の recipe への税は B で測る**
# （下調べの見積りは 3 本だが、#18-14-1 の 3 → 1 と同じく数えかたの誤りを
# 含むので当てにしない）。
$(BUILDDIR)/monster_levels_test: $(TESTDIR)/monster_levels_test.c \
                              $(TESTDIR)/minunit.h \
                              src/monster_levels.c \
                              src/monster_levels.h \
                              src/monsters.c | $(BUILDDIR)
	$(CC) $(CFLAGS) -o $@ $(TESTDIR)/monster_levels_test.c \
	    src/monster_levels.c src/monsters.c

# この階で増えたモンスターの数（ダンジョンとその中身から出す 3 つめの問い・
# #18-14-3）。もとは monsters.c:779 の `int16_t mon_tot_mult;` で、
# **定義表の隣に置かれた階ごとの数** —— 表とは何の関係も無い（#18-14-2 の
# m_level が 1 行上にいたのと同じ置きかた。どちらも「モンスターに関係する数は
# monsters.c」で済ませた跡）。
#
# **リンクするのは module 1 本だけ**で、足場（tests/*_fixture.c）は 1 つも
# 要らない —— 依存は MAX_MON_MULT（constant.h）1 つで、int16_t 1 つと比較 1 つ
# と足し引き 2 つで足りる。monster_turn_test と同じ 2 コンパイル単位。
#
# **A のあいだは器が 2 つある** —— monsters.c:779 の `mon_tot_mult`（本体が
# 使う）と、この module の static（テストだけが見る）。#18-14-1A・#18-14-2A と
# 同じで、本体が窓口を 1 つも呼んでいないから食いちがわない
# （→ GLOBALS_INVENTORY.md 所見 52）。**C では tests/creature_stubs.c:66 の
# 代役 `int16_t mon_tot_mult;` を消すのを忘れないこと** —— #18-14-1C で
# hack_monptr のそれを消し忘れた（上の movement_rate_test の註）。
#
# **他の recipe への税は B で測る。** 下調べの見積りは 4 本だが、#18-14-1 の
# 3 → 1 と #18-14-2 の 3 → 0 と同じ数えかたの誤り（名前が出るファイルを
# 数えて、recipe がそのファイルを並べているかを見ていない）を含むので
# 当てにしない。窓口を呼ぶのは creature.c・dungeon.c・moria3.c・save.c の
# 4 ファイルで、**このうち recipe に出てくるのは creature.c（movement_rate_test）
# と save.c（save_test 系）**。
$(BUILDDIR)/monster_breeding_test: $(TESTDIR)/monster_breeding_test.c \
                              $(TESTDIR)/minunit.h \
                              src/monster_breeding.c \
                              src/monster_breeding.h | $(BUILDDIR)
	$(CC) $(CFLAGS) -o $@ $(TESTDIR)/monster_breeding_test.c \
	    src/monster_breeding.c

clean:
	rm -rf $(BUILDDIR)
