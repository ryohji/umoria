# makefile.test -- 単体テストのビルドと実行
#
# 本体の makefile とは独立している。理由は 2 つ。
#   1. 本体は ncurses を必要とするが、テスト対象のロジック層は必要としない。
#      テストだけを ncurses なしで動かせるようにしておく。
#   2. テストの追加が本体のビルドに影響しないようにする。
#
# 使い方:
#   make -f makefile.test          # 全テストをビルドして実行
#   make -f makefile.test clean

CC = gcc
STD = -std=c17
WARNINGS = -Wall -Wextra -Wno-unused-parameter
CFLAGS = $(STD) $(WARNINGS) -g -Isrc -Itests
TESTDIR = tests
BUILDDIR = $(TESTDIR)/build

# テストは 1 実行形式につき 1 対象モジュール。
# 対象を増やすときは、ここに <name>_test を足し、下に依存関係を書く。
TESTS = distance_test device_chance_test item_ident_test inven_stack_test \
        put_misc3_test haggle_comment_test

BINS = $(addprefix $(BUILDDIR)/,$(TESTS))

.PHONY: all clean run
all: run

# 全テストを実行し、1 つでも失敗したら全体を失敗にする。
# グリーン／レッドがひと目でわかることが目的。
run: $(BINS)
	@echo "== running unit tests =="
	@fail=0; for t in $(BINS); do \
		echo "--- $$t ---"; \
		$$t || fail=1; \
	done; \
	echo; \
	if [ $$fail -eq 0 ]; then \
		echo "RESULT: GREEN"; \
	else \
		echo "RESULT: RED"; \
	fi; \
	exit $$fail

$(BUILDDIR):
	@mkdir -p $(BUILDDIR)

# distance() は misc1.c にあるが、misc1.c 全体をリンクすると
# ダンジョン生成や画面表示への依存が芋づるで付いてくる。
# テスト側で対象関数の宣言だけを使い、実装は misc1.c から取りだす。
$(BUILDDIR)/distance_test: $(TESTDIR)/distance_test.c $(TESTDIR)/minunit.h | $(BUILDDIR)
	$(CC) $(CFLAGS) -o $@ $(TESTDIR)/distance_test.c

# 魔法道具の chance 計算は src/device.c に抽出されている。依存は randint()
# だけなので、misc1.c をリンクせずテスト側で randint() を定義して差しかえる
# （リンクシーム）。写しではなく実体を検証している。
$(BUILDDIR)/device_chance_test: $(TESTDIR)/device_chance_test.c src/device.c src/device.h $(TESTDIR)/minunit.h | $(BUILDDIR)
	$(CC) $(CFLAGS) -o $@ $(TESTDIR)/device_chance_test.c src/device.c

# アイテム鑑定時の処理は src/item_ident.c に抽出されている。元の
# potions.c / eat.c / scrolls.c は巨大な switch が画面表示・ダンジョンに
# 依存するのでリンクできないが、item_ident.c は known1_p() / identify() /
# sample() / prt_experience() とグローバルな py / inventory にしか
# 依存しない。判定に使う known1_p() / identify() / sample() は src/desc.c の
# 本物をリンクする。desc.c が参照する定数テーブル（tables.c）とグローバルな
# インベントリ（treasure.c）も本物を使い、py と画面出力だけを
# tests/fixture.c で補う（リンクシーム）。写しではなく実体を検証している。
#
# desc.c の sprintf に -Wformat-overflow の警告が出るが、本体側の既存の
# 事情なのでテストのために本体を変えない。この 1 つだけ警告を落とす。
$(BUILDDIR)/item_ident_test: $(TESTDIR)/item_ident_test.c $(TESTDIR)/fixture.c \
                             $(TESTDIR)/fixture.h $(TESTDIR)/minunit.h \
                             src/item_ident.c src/item_ident.h \
                             src/desc.c src/tables.c src/treasure.c | $(BUILDDIR)
	$(CC) $(CFLAGS) -Wno-format-overflow -o $@ $(TESTDIR)/item_ident_test.c \
	    $(TESTDIR)/fixture.c src/item_ident.c src/desc.c src/tables.c src/treasure.c

# アイテムのスタック可否判定は misc3.c の inven_check_num() と inven_carry() に
# 二重に書かれている（本体のコメントが「must be identical」と明記している）。
# 写しではなく実体を検証したいので misc3.c をそのままリンクする。
#
# misc3.c は 2212 行・6 責務（画面描画・能力値計算・持ち物管理・呪文・戦闘・
# 移動）が同居しているため、リンクすると 57 個の未解決シンボルが芋づるで
# 付いてくる。内訳はリンカに列挙させ、3 つに分けた。
#   本物をリンクできるもの: 定数表（tables.c）、インベントリと object_ident
#     （treasure.c）、py と各種テーブル（player.c）、known1_p（desc.c）
#   代役で足りるもの: 画面描画・入力・ダンジョン・モンスター（misc3_stubs.c）
# fixture.c は使わない。py・msg_print・insert_str・prt_experience を
# player.c / misc3.c が本物として持っているので multiple definition になる。
# 代わりに misc3_stubs.c が fixture.h の窓口を提供する。
#
# desc.c / misc3.c の sprintf に -Wformat-overflow の警告が出るが、本体側の
# 既存の事情なのでテストのために本体を変えない。この 1 つだけ警告を落とす。
$(BUILDDIR)/inven_stack_test: $(TESTDIR)/inven_stack_test.c \
                              $(TESTDIR)/misc3_stubs.c \
                              $(TESTDIR)/fixture.h $(TESTDIR)/minunit.h \
                              src/misc3.c src/desc.c src/tables.c \
                              src/treasure.c src/player.c src/abilities.c | $(BUILDDIR)
	$(CC) $(CFLAGS) -Wno-format-overflow -o $@ $(TESTDIR)/inven_stack_test.c \
	    $(TESTDIR)/misc3_stubs.c src/misc3.c src/desc.c src/tables.c \
	    src/treasure.c src/player.c src/abilities.c

# キャラクターの能力値算出（9 式）は misc3.c:967 の put_misc3() と
# files.c:232 の file_character() に二重に書かれている。写しではなく実体を
# 検証したいので misc3.c をそのままリンクする。リンク構成は
# inven_stack_test と同じ（misc3.c の 57 個の未解決シンボルを
# misc3_stubs.c の代役で埋め、定数表・インベントリ・py は本物を使う）。
#
# 9 式はローカル変数なので直接は見えないが、put_misc3() は結果を
# put_buffer() で画面に書く。代役の put_buffer が記録した内容を
# fixture_screen_text() で読みとって観測する。本体は変更していない。
#
# ステップ B で 9 式は src/abilities.c の calc_player_abilities() に
# 抽出した。put_misc3() がそれを呼ぶので abilities.c もリンクする。
# 観測の経路（put_buffer 越し）は変わっていない。
$(BUILDDIR)/put_misc3_test: $(TESTDIR)/put_misc3_test.c \
                            $(TESTDIR)/misc3_stubs.c \
                            $(TESTDIR)/fixture.h $(TESTDIR)/minunit.h \
                            src/misc3.c src/desc.c src/tables.c \
                            src/treasure.c src/player.c \
                            src/abilities.c src/abilities.h | $(BUILDDIR)
	$(CC) $(CFLAGS) -Wno-format-overflow -o $@ $(TESTDIR)/put_misc3_test.c \
	    $(TESTDIR)/misc3_stubs.c src/misc3.c src/desc.c src/tables.c \
	    src/treasure.c src/player.c src/abilities.c

# 値切り交渉のコメント表示は store2.c:123 の prt_comment2() と
# store2.c:137 の prt_comment3() に二重に書かれている。差異は配列名・要素数と
# 呼びだし側の引数順だけ（store2.c:571 / store2.c:773 で offer と asking が
# 逆に渡される）。
#
# どちらも static なので外から呼べない。写しでは統合後の実体を検証できず
# 保護にならないので、テスト側が src/store2.c を #include して実体ごと
# 取りこみ、static 関数を直接呼ぶ。ゆえに store2.c は依存に書くが
# コンパイル対象には並べない（二重定義になる）。
#
# 出力は msg_print() で画面に出るだけなので、misc3_stubs.c の代役が記録した
# 内容を fixture_message_text() で読みとる。リンク構成は inven_stack_test と
# 同じ（misc3.c の未解決シンボルを代役で埋め、定数表・インベントリ・py は
# 本物を使う）。store2.c だけが要求する 14 個のシンボルは
# haggle_comment_test.c の中に置いた（misc3.c 系の他のテストには不要）。
#
# store2.c / desc.c / misc3.c の sprintf に -Wformat-overflow の警告が出るが、
# 本体側の既存の事情なのでテストのために本体を変えない。この 1 つだけ
# 警告を落とす。
$(BUILDDIR)/haggle_comment_test: $(TESTDIR)/haggle_comment_test.c \
                                 $(TESTDIR)/misc3_stubs.c \
                                 $(TESTDIR)/fixture.h $(TESTDIR)/minunit.h \
                                 src/store2.c src/misc3.c src/desc.c \
                                 src/tables.c src/treasure.c src/player.c \
                                 src/abilities.c | $(BUILDDIR)
	$(CC) $(CFLAGS) -Wno-format-overflow -o $@ $(TESTDIR)/haggle_comment_test.c \
	    $(TESTDIR)/misc3_stubs.c src/misc3.c src/desc.c src/tables.c \
	    src/treasure.c src/player.c src/abilities.c

clean:
	rm -rf $(BUILDDIR)
