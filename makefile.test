# 値切り交渉のコメント表示は store2.c:123 の prt_comment2() と
# store2.c:137 の prt_comment3() に二重に書かれている。差異は配列名・要素数と
# 呼びだし側の引数順だけ（store2.c:571 / store2.c:773 で offer と asking が
# 逆に渡される）。
#
# どちらも static なので外から呼べない。写しでは統合後の実体を検証できず
# 保護にならないので、テスト側が src/store2.c を #include して実体ごと
# 取りこみ、static 関数を直接呼ぶ。ゆえに store2.c は依存に書くが
# コンパイル対象には並べない（二重定義になる）。
#
# 出力は msg_print() で画面に出るだけなので、misc3_stubs.c の代役が記録した
# 内容を fixture_message_text() で読みとる。リンク構成は inven_stack_test と
# 同じ（misc3.c の未解決シンボルを代役で埋め、定数表・インベントリ・py は
# 本物を使う）。store2.c だけが要求する 14 個のシンボルは
# haggle_comment_test.c の中に置いた（misc3.c 系の他のテストには不要）。
#
# 値切りのコメントは insert_lnum で数値を差しこむので、#41B で移した
# src/str_insert.c もリンクする（リンカが未解決として挙げた 2 箇所は
# haggle_comment_test.c:146-147 の呼びだし）。
#
# store2.c のコマンド待ちループがメッセージの状態（旧 msg_flag）にふれるので
# messages.c もリンクする。代役でもよいが、依存が無い module なので本物のほうが
# 短い。
#
# 店の記録も src/stores.c 越しになった。こちらも依存が無いので本物をリンクする
# （値切りは s_ptr の中身を読むだけで、記録の置き場には関心が無い）。
# 居場所の窓口 src/player_pos.c も同じ（#18-6B5。misc3.c が呼ぶ）。
#
# #18-11-3B で store2.c が「再開する持ち物コマンド」を窓口越しに読むように
# なったので src/inven_command_state.c を足した。その窓口の中断側が
# screen_touched.h を呼ぶので src/screen_touched.c も付いてくる（中断は 2 つで
# 1 つの行いなので、module を 2 本に分けてもリンクは 2 本で 1 組）。実体はまだ
# variable.c にあったが、**#18-11-3C で 2 本の static になったので足場も代役も
# 要らなくなった** —— haggle_comment_test.c の doing_inven の定義と、足場
# tests/screen_touched_fixture.c の両方を消した（残すと窓口越しの読み書きが
# 届かない別の器になる）。この 2 本が窓口と置き場の両方になっている。
$(BUILDDIR)/haggle_comment_test: $(TESTDIR)/haggle_comment_test.c \
                                 $(TESTDIR)/misc3_stubs.c \
                                 $(TESTDIR)/fixture.h $(TESTDIR)/minunit.h \
                                 src/store2.c src/command_state.c src/misc3.c src/player_display_numbers.c src/player_gold.c src/player_mana.c src/player_mana.h src/player_hp.c src/player_hp.h src/stats.c \
                                 src/pending_teleport.c src/pending_teleport.h \
                                 src/str_insert.c src/desc.c \
                                 src/tables.c src/inventory.c \
                                 src/treasure.c src/player.c \
                                 src/abilities.c src/messages.c src/stores.c \
                                 src/progress.c src/score_death.c \
                                 src/save_state.c \
                                 src/player_pos.c src/hp_table.c \
                                 src/burden.c src/burden.h \
                                 src/spells_known.c src/spells_known.h src/item_ident.c src/item_ident.h \
                            src/object_levels.c src/object_levels.h \
                                 src/inven_command_state.c \
                                 src/inven_command_state.h \
                                 src/screen_touched.c src/screen_touched.h \
                                 src/player_level.c src/player_level.h \
                                 src/player_status_flags.c src/player_status_flags.h \
                                 src/player_timed_effects.c src/player_timed_effects.h \
                                 src/player_resting.c src/player_resting.h \
                                 src/player_speed.c src/player_speed.h \
                                 src/player_infra_range.c src/player_infra_range.h \
                                 src/player_spells_to_learn.c src/player_spells_to_learn.h \
                                 src/player_base_to_hit.c src/player_base_to_hit.h \
                                 src/player_saving_throw.c src/player_saving_throw.h \
                                 src/player_race.c src/player_race.h \
                                 src/player_body_weight.c src/player_body_weight.h \
                                 src/player_attack_bonuses.c src/player_attack_bonuses.h \
                                 src/player_search_skill.c src/player_search_skill.h \
                                 src/player_bio.c src/player_bio.h \
                                 src/player_stealth.c src/player_stealth.h \
                                 src/player_class.c src/player_class.h \
                                 src/player_disarm.c src/player_disarm.h | $(BUILDDIR)
	$(CC) $(CFLAGS) -o $@ $(TESTDIR)/haggle_comment_test.c \
	    $(TESTDIR)/misc3_stubs.c src/command_state.c src/misc3.c src/player_display_numbers.c src/player_gold.c src/player_mana.c src/player_hp.c src/pending_teleport.c src/stats.c src/str_insert.c \
	    src/desc.c src/tables.c src/inventory.c \
	    src/treasure.c src/player.c src/abilities.c src/messages.c \
	    src/stores.c src/progress.c src/score_death.c src/save_state.c \
	    src/player_pos.c src/hp_table.c src/burden.c src/spells_known.c src/item_ident.c src/object_levels.c \
	    src/inven_command_state.c src/screen_touched.c \
	    src/player_level.c \
	    src/player_status_flags.c \
	    src/player_timed_effects.c src/player_resting.c src/player_speed.c src/player_infra_range.c src/player_spells_to_learn.c \
	    src/player_base_to_hit.c \
