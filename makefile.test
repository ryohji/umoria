                            src/pending_teleport.c src/pending_teleport.h \
                            src/tables.c src/inventory.c \
                            src/treasure.c src/player.c \
                            src/abilities.c src/abilities.h \
                            src/progress.c src/score_death.c \
                            src/save_state.c \
                            src/player_pos.c src/hp_table.c \
                            src/burden.c src/burden.h \
                            src/spells_known.c src/spells_known.h src/item_ident.c src/item_ident.h \
                            src/object_levels.c src/object_levels.h \
                            src/player_level.c src/player_level.h \
                            src/player_status_flags.c src/player_status_flags.h \
                            src/player_speed.c src/player_speed.h \
                            src/player_infra_range.c src/player_infra_range.h \
                            src/player_spells_to_learn.c src/player_spells_to_learn.h \
                            src/player_base_to_hit.c src/player_base_to_hit.h \
                            src/player_saving_throw.c src/player_saving_throw.h \
                            src/player_race.c src/player_race.h \
                            src/player_body_weight.c src/player_body_weight.h \
                            src/player_attack_bonuses.c src/player_attack_bonuses.h \
                            src/player_search_skill.c src/player_search_skill.h \
                            src/player_bio.c src/player_bio.h \
                            src/player_stealth.c src/player_stealth.h \
                            src/player_class.c src/player_class.h \
                            src/player_disarm.c src/player_disarm.h | $(BUILDDIR)
	$(CC) $(CFLAGS) -o $@ $(TESTDIR)/calc_hitpoints_test.c \
	    $(TESTDIR)/misc3_stubs.c src/command_state.c src/misc3.c src/player_display_numbers.c src/player_gold.c src/player_mana.c src/player_hp.c src/pending_teleport.c src/stats.c src/str_insert.c \
	    src/desc.c src/tables.c src/inventory.c \
	    src/treasure.c src/player.c src/abilities.c \
	    src/progress.c src/score_death.c src/save_state.c \
	    src/player_pos.c src/hp_table.c src/burden.c src/spells_known.c src/item_ident.c src/object_levels.c \
	    src/player_level.c \
	    src/player_status_flags.c \
	    src/player_timed_effects.c src/player_resting.c src/player_speed.c src/player_infra_range.c src/player_spells_to_learn.c \
	    src/player_base_to_hit.c \
	    src/player_disarm.c \
	    src/player_saving_throw.c \
	    src/player_race.c \
	    src/player_body_weight.c \
	    src/player_attack_bonuses.c \
	    src/player_search_skill.c \
	    src/player_bio.c \
	    src/player_stealth.c \
	    src/player_class.c

# 飛び道具の通し番号の置き場（missile_serial）。ダンジョンで作られた矢や石の
# 束に 1 つずつ違う番号を配る（p1 に入り、items_can_stack() が「同じ束か」の
# 判定に使う）。依存は無く、MAX_SHORT を constant.h から取るだけ。
#
# #18-11-2C で実体（missile_ctr）も missile_serial.c の static になったので、
# この 1 本が窓口と置き場の両方になっている。足場も代役も 1 つも要らない
# （ステップ A で要った tests/missile_serial_fixture.c は実体が入ったときに
# 消した）。str_insert.c・inventory.c・player_light.c と同じ 2 単位。
$(BUILDDIR)/missile_serial_test: $(TESTDIR)/missile_serial_test.c \
                                 $(TESTDIR)/minunit.h \
                                 src/missile_serial.c src/missile_serial.h | $(BUILDDIR)
	$(CC) $(CFLAGS) -o $@ $(TESTDIR)/missile_serial_test.c src/missile_serial.c

# 中断した持ち物コマンドの 2 つの半分（#18-11-3）。ユーザーの判断で module を
# 2 本に分けた —— 「再開する文字」（inven_command_state）と「画面が流されたか」
# （screen_touched）は読み手が違う（前者は dungeon.c と store2.c、後者は io.c と
# creature.c が立てて moria1.c が読む）。
#
# ただし**中断は 2 つで 1 つの行い**なので、suspend_inven_command() が
# screen_touched.h の窓口を呼ぶ。だから inven_command_state_test は
# screen_touched.c もリンクする（このテストの要は、その 2 つが一緒に動くこと）。
#
# #18-11-3C で実体（pending_command / screen_flushed）も 2 本の static になった
# ので、足場も代役も 1 つも要らない。screen_touched_test は **2 単位・代役 0**
# （str_insert.c・inventory.c・player_light.c・missile_serial.c と同じ最小形）。
# inven_command_state_test は 3 単位で、増えた 1 本は代役ではなく
# src/screen_touched.c 自身 —— 中断が 2 つで 1 つであることを見るため。
$(BUILDDIR)/screen_touched_test: $(TESTDIR)/screen_touched_test.c \
                                 $(TESTDIR)/minunit.h \
                                 src/screen_touched.c src/screen_touched.h | $(BUILDDIR)
	$(CC) $(CFLAGS) -o $@ $(TESTDIR)/screen_touched_test.c src/screen_touched.c

$(BUILDDIR)/inven_command_state_test: $(TESTDIR)/inven_command_state_test.c \
                                      $(TESTDIR)/minunit.h \
                                      src/inven_command_state.c \
                                      src/inven_command_state.h \
                                      src/screen_touched.c src/screen_touched.h | $(BUILDDIR)
	$(CC) $(CFLAGS) -o $@ $(TESTDIR)/inven_command_state_test.c \
	    src/inven_command_state.c src/screen_touched.c

# turn を途中で切りあげる 2 つの理由（#18-11-4）。ユーザーの判断で module を
# 2 本に分けた —— 「この階は終わったか」（level_exit）と「teleport が待っているか」
# （pending_teleport）は起きる場所も読まれかたも違う。
#
# level_exit のほうは **dun_level と対で動く形を窓口にした**（これもユーザーが
# 決めた）。8 か所のうち 6 か所が深さの置きかえと並んでいたので、
# leave_for_level(n) がその両方をやる。だから level_exit_test は dun_level を
# 足場に持つ。
#
# #18-11-4C で実体（level_over / teleport_pending）も 2 本の static になったので、
# pending_teleport_test は **2 単位・代役 0**（str_insert.c・inventory.c・
# player_light.c・missile_serial.c・screen_touched.c と同じ最小形。足場
# tests/pending_teleport_fixture.c は実体が入ったときに消した）。
#
# level_exit_test に残っている tests/level_exit_fixture.c は **旗の足場ではない**。
# 中身は dun_level 1 つだけで、これは別の区分（地下そのもの）の global ——
# leave_for_level() が対で書きかえる相手なので要る。dun_level を閉じる人が
# このファイルを消す。
$(BUILDDIR)/level_exit_test: $(TESTDIR)/level_exit_test.c \
                             $(TESTDIR)/level_exit_fixture.c \
                             $(TESTDIR)/minunit.h \
                             src/level_exit.c src/level_exit.h | $(BUILDDIR)
	$(CC) $(CFLAGS) -o $@ $(TESTDIR)/level_exit_test.c src/level_exit.c \
	    $(TESTDIR)/level_exit_fixture.c

$(BUILDDIR)/pending_teleport_test: $(TESTDIR)/pending_teleport_test.c \
                                   $(TESTDIR)/minunit.h \
                                   src/pending_teleport.c src/pending_teleport.h | $(BUILDDIR)
	$(CC) $(CFLAGS) -o $@ $(TESTDIR)/pending_teleport_test.c src/pending_teleport.c

# 入力が尽きたか（input_ended）。#18-11-5A で新設。ゲーム全体についての 1 つの
# 事実で、読み手は io.c・dungeon.c・main.c・save.c と game_state.c の写しとり。
#
# **我慢の回数（元の io.c:81 の `eof_flag > 100`）は窓口の内側に入れた**
# （ユーザーが決めた。呼び手は 1 つで、数えている唯一の理由がこれ）。だから
# 境目を見るテストはここにしか無い。**尽きた状態を戻す窓口は無い** ので、
# テストは 1 本道として並んでいる（tests/input_ended_test.c の頭に書いてある）。
#
# #18-11-5C で実体（eof_count）も input_ended.c の static になったので、これは
# **2 単位・代役 0**（str_insert.c・inventory.c・player_light.c・
# missile_serial.c・screen_touched.c・pending_teleport.c と同じ最小形。足場
# tests/input_ended_fixture.c は実体が入ったときに消した）。
$(BUILDDIR)/input_ended_test: $(TESTDIR)/input_ended_test.c \
                              $(TESTDIR)/minunit.h \
                              src/input_ended.c src/input_ended.h | $(BUILDDIR)
	$(CC) $(CFLAGS) -o $@ $(TESTDIR)/input_ended_test.c src/input_ended.c

# 走っているか／何歩走ったか（running）。#18-11-6A で新設。1 つの int が旗と
# 歩数計を兼ねていたので、窓口は問いごとに分けた（走っているか・走りだす・
# 止める・階の始まりに忘れる・1 歩進めてまだ走れるか・写しとり用の生）。
#
# **息切れの回数（元の moria2.c:287 の `find_flag++ > 100`）は窓口の内側に
# 入れた**（ユーザーが決めた。読み手は 1 つで、歩数を数えている唯一の理由が
# これ）。だから境目を見るテストはここにしか無い。**「もう走れない」と言うだけで
# 止めはしない**（止めるのは find_run() の側）ので、それも 1 件で押さえている。
#
# #18-11-6C で実体（run_steps）も running.c の static になったので、これは
# **2 単位・代役 0**（input_ended.c・str_insert.c・inventory.c・player_light.c・
# missile_serial.c・screen_touched.c・pending_teleport.c と同じ最小形。足場
# tests/running_fixture.c は実体が入ったときに消した）。
$(BUILDDIR)/running_test: $(TESTDIR)/running_test.c \
                          $(TESTDIR)/minunit.h \
                          src/running.c src/running.h | $(BUILDDIR)
	$(CC) $(CFLAGS) -o $@ $(TESTDIR)/running_test.c src/running.c

# 打っているコマンドについて覚えていること（command_state）。#18-11-7A で新設。
# 3 つの global（`command_count` `default_dir` `last_command`）が 1 本に入って
# いる —— **どれも「コマンドに繰りかえしの回数を付けられる」ことから出ている**
# ので、ユーザーの判断で module 1 本にまとめた。
#
# **「数を受けとって終わりにする」（5 か所）と「退避して戻す」（3 か所）の
# 2 つの言いまわしも窓口の内側に入れた**（ユーザーが決めた）。後者は値を呼び手に
# 返す形にしてある —— dungeon.c の `-` の hack と get_dir() が入れ子で抱えるので、
# module の中に置き場を 1 つ持つと内側の戻しが外側を上書きする。テストの
# held_counts_can_nest がそれを押さえている。
#
# #18-11-7C で実体が src/command_state.c の static に入ったので、リンクは
# **テスト＋ module の 2 本だけ**になった（足場 tests/command_state_fixture.c と
# tests/misc3_stubs.c の代役 3 個は消した）。misc3.c を引く 9 本が
# src/command_state.c をリンクする行はそのまま要る —— prt_state() が窓口を呼び、
# 実体はいまその中にある。
$(BUILDDIR)/command_state_test: $(TESTDIR)/command_state_test.c \
                                $(TESTDIR)/minunit.h \
                                src/command_state.c src/command_state.h | $(BUILDDIR)
	$(CC) $(CFLAGS) -o $@ $(TESTDIR)/command_state_test.c src/command_state.c

# 明かりについて覚えている 2 つの答えの置き場（player_light）。1 つめ
# （明かりが燃えているか）は #18-7-3C1、2 つめ（明かりの輪が地図に描かれて
# いるか）は #18-11-1C で実体が src/player_light.c の static になった。この
# 1 本が窓口と置き場の両方なので、足場も代役も 1 つも要らない
# （それぞれの足場 tests/player_light_fixture.c と tests/lamp_glow_fixture.c は
# 実体が入ったときに消した）。
$(BUILDDIR)/player_light_test: $(TESTDIR)/player_light_test.c \
                               $(TESTDIR)/minunit.h \
                               src/player_light.c src/player_light.h \
                               src/player_timed_effects.c src/player_timed_effects.h \
                               src/player_resting.c src/player_resting.h | $(BUILDDIR)
	$(CC) $(CFLAGS) -o $@ $(TESTDIR)/player_light_test.c src/player_light.c

# 重さに負けているかどうかの判定（misc3.c:975 の check_strength と
# misc3.c:957 の inven_check_weight）。2 つの答えを書く唯一の場所で、
# 単体テストが 1 件も届いていなかった。戻り値が無く、結果はメッセージ・
# 速度（change_speed）・能力の再計算（calc_bonuses）にしか現れないので、
# misc3_stubs.c の代役が記録した内容を fixture.h の窓口で読みとる。
#
# リンク構成は put_misc3_test・calc_hitpoints_test と同じ（misc3.c の未解決
# シンボルを代役で埋め、定数表・インベントリ・py は本物を使う）＋ 覚えた
# 答えを読み書きする src/burden.c。weapon_heavy と pack_heavy の実体は
# ステップ A のあいだ misc3_stubs.c:43,53 にあり、burden.c の窓口はそれを
