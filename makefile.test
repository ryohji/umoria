                            src/pending_teleport.c src/pending_teleport.h \
                            src/tables.c src/inventory.c \
                            src/treasure.c src/player.c \
                            src/abilities.c src/abilities.h \
                            src/progress.c src/score_death.c \
                            src/save_state.c \
                            src/player_pos.c src/hp_table.c \
                            src/burden.c src/burden.h \
                            src/spells_known.c src/spells_known.h src/item_ident.c src/item_ident.h \
