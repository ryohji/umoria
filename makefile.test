# makefile.test -- 単体テストのビルドと実行
#
# 本体の makefile とは独立している。理由は 2 つ。
#   1. 本体は ncurses を必要とするが、テスト対象のロジック層は必要としない。
#      テストだけを ncurses なしで動かせるようにしておく。
#   2. テストの追加が本体のビルドに影響しないようにする。
#
# 使い方:
#   make -f makefile.test          # 全テストをビルドして実行
#   make -f makefile.test clean

CC = gcc
STD = -std=c17
# 本体（makefile:18-20）に近づけているが、同一ではない。
# 本体にあってここに無いもの:
#   -Wpedantic            本体ヘッダ（externs.h）由来の警告が数百件出て、
#                         テスト自身の問題が埋もれる
#   -Wmissing-prototypes  代役ファイルは本体の宣言（externs.h）を include
#                         しない設計なので、原理的に全代役が警告になる
#   -Wnested-externs      fixture_reset() が関数内 extern でグローバルを
#                         参照する形なので、意図的にこの形を使っている
# これらを外した状態で、テストコード由来の警告は 0 件を保つ。
WARNINGS = -Wall -Wextra -Wno-unused-parameter \
           -Wshadow -Wstrict-prototypes -Wold-style-definition \
           -Wformat=2 -Wwrite-strings
# 以前はここに本体由来の既存警告（非プロトタイプ宣言・const の落ち・
# 文字列リテラルへの書きこみ等、数千件）の抑制を並べていた。本体側の
# 警告解消でどれも 0 件になったので、抑制ごと外した。テスト・本体とも
# この設定で警告 0 件。
CFLAGS = $(STD) $(WARNINGS) -g -Isrc -Itests
TESTDIR = tests
BUILDDIR = $(TESTDIR)/build

# テストは 1 実行形式につき 1 対象モジュール。
# 対象を増やすときは、ここに <name>_test を足し、下に依存関係を書く。
TESTS = distance_test device_chance_test item_ident_test inven_stack_test \
        put_misc3_test haggle_comment_test movement_rate_test \
        stat_bonus_test objdes_test creature_iterator_test save_bool_test \
        options_test messages_test panel_test stores_test store_save_test \
        str_insert_test inventory_test progress_test score_death_test \
        save_state_test player_pos_test

BINS = $(addprefix $(BUILDDIR)/,$(TESTS))

.PHONY: all clean run
all: run

# 全テストを実行し、1 つでも失敗したら全体を失敗にする。
# グリーン／レッドがひと目でわかることが目的。
run: $(BINS)
	@echo "== running unit tests =="
	@fail=0; for t in $(BINS); do \
		echo "--- $$t ---"; \
		$$t || fail=1; \
	done; \
	echo; \
	if [ $$fail -eq 0 ]; then \
		echo "RESULT: GREEN"; \
	else \
		echo "RESULT: RED"; \
	fi; \
	exit $$fail

$(BUILDDIR):
	@mkdir -p $(BUILDDIR)

# distance() は misc1.c にあるが、misc1.c 全体をリンクすると
# ダンジョン生成や画面表示への依存が芋づるで付いてくる。
# テスト側で対象関数の宣言だけを使い、実装は misc1.c から取りだす。
$(BUILDDIR)/distance_test: $(TESTDIR)/distance_test.c $(TESTDIR)/minunit.h | $(BUILDDIR)
	$(CC) $(CFLAGS) -o $@ $(TESTDIR)/distance_test.c

# 魔法道具の chance 計算は src/device.c に抽出されている。依存は randint()
# だけなので、misc1.c をリンクせずテスト側で randint() を定義して差しかえる
# （リンクシーム）。写しではなく実体を検証している。
$(BUILDDIR)/device_chance_test: $(TESTDIR)/device_chance_test.c src/device.c src/device.h $(TESTDIR)/minunit.h | $(BUILDDIR)
	$(CC) $(CFLAGS) -o $@ $(TESTDIR)/device_chance_test.c src/device.c

# アイテム鑑定時の処理は src/item_ident.c に抽出されている。元の
# potions.c / eat.c / scrolls.c は巨大な switch が画面表示・ダンジョンに
# 依存するのでリンクできないが、item_ident.c は known1_p() / identify() /
# sample() / prt_experience() とグローバルな py / inventory にしか
# 依存しない。判定に使う known1_p() / identify() / sample() は src/desc.c の
# 本物をリンクする。desc.c が参照する定数テーブル（tables.c）とグローバルな
# インベントリ（inventory.c）も本物を使い、py と画面出力だけを
# tests/fixture.c で補う（リンクシーム）。写しではなく実体を検証している。
#
# #41B で insert_str / insert_lnum の実体は src/str_insert.c へ移ったが、この
# 構成は src/str_insert.c を「リンクしない」。desc.c は insert_str を呼ぶが、
# ここで見ているのは鑑定時の経験値と識別フラグで、名前の複数形化は関係しない。
# fixture.c:75 の空の代役を残し、実体は同居させない（同居させると multiple
# definition になる）。名前組み立ての実体を見るのは objdes_test / str_insert_test。
#
# #18-5B で desc.c が持ち物の窓口（inventory_at / inventory_count /
# inventory_set_count）越しに inventory を触るようになったので src/inventory.c を
# 足す（リンカが未解決として挙げた）。#18-5C で実体（inventory[] と 3 つの
# 数え）も treasure.c から inventory.c に移り static になったので、この 1 本が
# 窓口と置き場の両方になった。tests/fixture.c も窓口越しに消す。
$(BUILDDIR)/item_ident_test: $(TESTDIR)/item_ident_test.c $(TESTDIR)/fixture.c \
                             $(TESTDIR)/fixture.h $(TESTDIR)/minunit.h \
                             src/item_ident.c src/item_ident.h \
                             src/desc.c src/tables.c src/treasure.c \
                             src/inventory.c src/progress.c | $(BUILDDIR)
	$(CC) $(CFLAGS) -o $@ $(TESTDIR)/item_ident_test.c \
	    $(TESTDIR)/fixture.c src/item_ident.c src/desc.c src/tables.c src/treasure.c \
	    src/inventory.c src/progress.c

# アイテムのスタック可否判定は misc3.c の inven_check_num() と inven_carry() に
# 二重に書かれている（本体のコメントが「must be identical」と明記している）。
# 写しではなく実体を検証したいので misc3.c をそのままリンクする。
#
# misc3.c は 2212 行・6 責務（画面描画・能力値計算・持ち物管理・呪文・戦闘・
# 移動）が同居しているため、リンクすると 57 個の未解決シンボルが芋づるで
# 付いてくる。内訳はリンカに列挙させ、3 つに分けた。
#   本物をリンクできるもの: 定数表（tables.c）、object_ident（treasure.c）、
#     インベントリ（inventory.c）、py と各種テーブル（player.c）、
#     known1_p（desc.c）
#   代役で足りるもの: 画面描画・入力・ダンジョン・モンスター（misc3_stubs.c）
# fixture.c は使わない。py・msg_print・insert_str・prt_experience を
# player.c / misc3.c が本物として持っているので multiple definition になる。
# 代わりに misc3_stubs.c が fixture.h の窓口を提供する。
#
# #41B で insert_str の実体が src/str_insert.c に移ったので、この構成では
# そちらもリンクする（desc.c が呼ぶ。リンカが未解決として挙げた）。
#
# #18-5B7 で misc3.c が持ち物と装備を src/inventory.h / src/equipment.h の窓口
# 越しに引くようになったので、その実体（src/inventory.c）もリンクする。
# #18-5C で配列そのものも inventory.c の static 定義になったので、テスト側
# （inven_stack_test.c と misc3_stubs.c）も窓口越しに読み書きする。
#
# #18-6B5 で misc3.c が居場所を src/player_pos.h の窓口越しに引くように
# なったので src/player_pos.c もリンクする（実体はまだ src/player.c にあり、
# この構成はそれをリンクしているので足場は要らない）。
$(BUILDDIR)/inven_stack_test: $(TESTDIR)/inven_stack_test.c \
                              $(TESTDIR)/misc3_stubs.c \
                              $(TESTDIR)/fixture.h $(TESTDIR)/minunit.h \
                              src/misc3.c src/stats.c src/str_insert.c src/desc.c \
                              src/tables.c src/inventory.c \
                              src/treasure.c src/player.c src/abilities.c \
                              src/progress.c src/score_death.c \
                              src/save_state.c \
                              src/player_pos.c | $(BUILDDIR)
	$(CC) $(CFLAGS) -o $@ $(TESTDIR)/inven_stack_test.c \
	    $(TESTDIR)/misc3_stubs.c src/misc3.c src/stats.c src/str_insert.c \
	    src/desc.c src/tables.c src/inventory.c \
	    src/treasure.c src/player.c src/abilities.c \
	    src/progress.c src/score_death.c src/save_state.c \
	    src/player_pos.c

# キャラクターの能力値算出（9 式）は misc3.c:967 の put_misc3() と
# files.c:232 の file_character() に二重に書かれている。写しではなく実体を
# 検証したいので misc3.c をそのままリンクする。リンク構成は
# inven_stack_test と同じ（misc3.c の 57 個の未解決シンボルを
# misc3_stubs.c の代役で埋め、定数表・インベントリ・py は本物を使う）。
#
# 9 式はローカル変数なので直接は見えないが、put_misc3() は結果を
# put_buffer() で画面に書く。代役の put_buffer が記録した内容を
# fixture_screen_text() で読みとって観測する。本体は変更していない。
#
# ステップ B で 9 式は src/abilities.c の calc_player_abilities() に
# 抽出した。put_misc3() がそれを呼ぶので abilities.c もリンクする。
# 観測の経路（put_buffer 越し）は変わっていない。
#
# #18-6B5 で misc3.c が居場所の窓口を呼ぶので src/player_pos.c もリンクする
# （inven_stack_test と同じ理由）。
$(BUILDDIR)/put_misc3_test: $(TESTDIR)/put_misc3_test.c \
                            $(TESTDIR)/misc3_stubs.c \
                            $(TESTDIR)/fixture.h $(TESTDIR)/minunit.h \
                            src/misc3.c src/stats.c src/str_insert.c src/desc.c \
                            src/tables.c src/inventory.c \
                            src/treasure.c src/player.c \
                            src/abilities.c src/abilities.h \
                            src/progress.c src/score_death.c \
                            src/save_state.c \
                            src/player_pos.c | $(BUILDDIR)
	$(CC) $(CFLAGS) -o $@ $(TESTDIR)/put_misc3_test.c \
	    $(TESTDIR)/misc3_stubs.c src/misc3.c src/stats.c src/str_insert.c \
	    src/desc.c src/tables.c src/inventory.c \
	    src/treasure.c src/player.c src/abilities.c \
	    src/progress.c src/score_death.c src/save_state.c \
	    src/player_pos.c

# 値切り交渉のコメント表示は store2.c:123 の prt_comment2() と
# store2.c:137 の prt_comment3() に二重に書かれている。差異は配列名・要素数と
# 呼びだし側の引数順だけ（store2.c:571 / store2.c:773 で offer と asking が
# 逆に渡される）。
#
# どちらも static なので外から呼べない。写しでは統合後の実体を検証できず
# 保護にならないので、テスト側が src/store2.c を #include して実体ごと
# 取りこみ、static 関数を直接呼ぶ。ゆえに store2.c は依存に書くが
# コンパイル対象には並べない（二重定義になる）。
#
# 出力は msg_print() で画面に出るだけなので、misc3_stubs.c の代役が記録した
# 内容を fixture_message_text() で読みとる。リンク構成は inven_stack_test と
# 同じ（misc3.c の未解決シンボルを代役で埋め、定数表・インベントリ・py は
# 本物を使う）。store2.c だけが要求する 14 個のシンボルは
# haggle_comment_test.c の中に置いた（misc3.c 系の他のテストには不要）。
#
# 値切りのコメントは insert_lnum で数値を差しこむので、#41B で移した
# src/str_insert.c もリンクする（リンカが未解決として挙げた 2 箇所は
# haggle_comment_test.c:146-147 の呼びだし）。
#
# store2.c のコマンド待ちループがメッセージの状態（旧 msg_flag）にふれるので
# messages.c もリンクする。代役でもよいが、依存が無い module なので本物のほうが
# 短い。
#
# 店の記録も src/stores.c 越しになった。こちらも依存が無いので本物をリンクする
# （値切りは s_ptr の中身を読むだけで、記録の置き場には関心が無い）。
# 居場所の窓口 src/player_pos.c も同じ（#18-6B5。misc3.c が呼ぶ）。
$(BUILDDIR)/haggle_comment_test: $(TESTDIR)/haggle_comment_test.c \
                                 $(TESTDIR)/misc3_stubs.c \
                                 $(TESTDIR)/fixture.h $(TESTDIR)/minunit.h \
                                 src/store2.c src/misc3.c src/stats.c \
                                 src/str_insert.c src/desc.c \
                                 src/tables.c src/inventory.c \
                                 src/treasure.c src/player.c \
                                 src/abilities.c src/messages.c src/stores.c \
                                 src/progress.c src/score_death.c \
                                 src/save_state.c \
                                 src/player_pos.c | $(BUILDDIR)
	$(CC) $(CFLAGS) -o $@ $(TESTDIR)/haggle_comment_test.c \
	    $(TESTDIR)/misc3_stubs.c src/misc3.c src/stats.c src/str_insert.c \
	    src/desc.c src/tables.c src/inventory.c \
	    src/treasure.c src/player.c src/abilities.c src/messages.c \
	    src/stores.c src/progress.c src/score_death.c src/save_state.c \
	    src/player_pos.c

# モンスターの行動回数計算は src/creature.c:75 の movement_rate() にある。
# static なので外から呼べない。写しでは書きかえ後の実体を検証できず保護に
# ならないので、テスト側が src/creature.c を #include して実体ごと取りこみ、
# static 関数を直接呼ぶ。ゆえに creature.c は依存に書くがコンパイル対象には
# 並べない（二重定義になる）。
#
# creature.c は 1609 行（モンスターの移動・攻撃・呪文）なので、取りこむと
# 76 個の未解決シンボルが芋づるで付いてくる。movement_rate() の依存は
# グローバル turn と py.flags.rest の 2 つだけなので、本物のソースを 1 つも
# リンクせず、すべて tests/creature_stubs.c の代役で埋めるのが最小構成に
# なる（misc3_stubs.c だと py・msg_print・randint が重複する）。
# 一覧はリンカに列挙させたもので、手で数えあげたわけではない。
#
# turn の実体は #19C1 で src/progress.c の static になったので、そちらを
# リンクする。テストは progress_set_turn() で制御する（代役も extern も無い）。
#
# #18-5B31 で creature.c が持ち物・装備の窓口（equipment_at・inventory_at・
# inventory_count）を呼ぶようになったので、src/inventory.c を足した。
# 代役を書く形（creature_stubs.c に equipment_at 等を並べる）と比べてこちらを
# 選んだ理由は 2 つある。(1) 本物の窓口を通るので、窓口の書きかえがこの
# テストで検出できる。(2) リンカに聞いたら inventory.c が要求する未解決は
# 4 個だけだった。#18-5C でその 4 個は inventory.c 自身が static で持つように
# なったので、creature_stubs.c から 4 個の代役を消した（残しても inventory.c の
# 分とは別の器になり、窓口越しの読み書きが届かない）。
# inventory.c は externs.h を include しないので、
# 芋づるは 1 本も増えない（2 → 3 コンパイル単位）。
#
# #18-6B4 で creature.c が居場所の窓口（player_row・player_col）を呼ぶように
# なったので、同じ理由で src/player_pos.c もリンクする（3 → 4 コンパイル単位）。
# #18-6C1 で実体も player_pos.c の static になったので、creature_stubs.c から
# 代役 2 個を消した（残すと窓口越しの読み書きが届かない別の器になる。
# #18-5C と同じ）。この 1 本が窓口と置き場の両方になっている。
$(BUILDDIR)/movement_rate_test: $(TESTDIR)/movement_rate_test.c \
                                $(TESTDIR)/creature_stubs.c \
                                $(TESTDIR)/fixture.h $(TESTDIR)/minunit.h \
                                src/creature.c src/inventory.c \
                                src/equipment.h src/inventory.h \
                                src/progress.c src/score_death.c \
                                src/player_pos.c | $(BUILDDIR)
	$(CC) $(CFLAGS) -o $@ $(TESTDIR)/movement_rate_test.c \
	    $(TESTDIR)/creature_stubs.c src/inventory.c src/progress.c \
	    src/score_death.c src/player_pos.c

# 能力値の補正値を返す 7 関数（stat_adj / chr_adj / con_adj / tohit_adj /
# toac_adj / todis_adj / todam_adj）は src/stats.c にある。いずれも外部
# リンケージなのでそのまま呼べる。写しではなく実体を検証したいので
# stats.c をリンクする。
#
# #40B までは misc3.c にあり、8 コンパイル単位を引いていた
# （stat_bonus_test.c misc3_stubs.c + misc3.c desc.c tables.c treasure.c
# player.c abilities.c）。補正表の依存は py だけなのに、misc3.c と同居して
# いたせいで画面描画・持ち物・定数表が芋づるで付いてきていた。
# stats.c に切りだしたあとの未解決シンボルは py と fixture_reset の 2 個だけ
# なので、3 単位で足りる（#38 の芋づるリンクを数字で減らした最初の例）。
$(BUILDDIR)/stat_bonus_test: $(TESTDIR)/stat_bonus_test.c \
                             $(TESTDIR)/stats_fixture.c \
                             $(TESTDIR)/fixture.h $(TESTDIR)/minunit.h \
                             src/stats.c src/stats.h | $(BUILDDIR)
	$(CC) $(CFLAGS) -o $@ $(TESTDIR)/stat_bonus_test.c \
	    $(TESTDIR)/stats_fixture.c src/stats.c

# 未鑑定アイテムの名前組み立ては src/desc.c の objdes() にある。外部
# リンケージなのでそのまま呼べる。写しではなく実体を検証したいので desc.c を
# リンクする。
#
# objdes() は名前の複数形化に insert_str() を使う（#41B で misc3.c から
# src/str_insert.c へ移した）。fixture.c はこれを空の代役にしているので、
# fixture.c ではなく misc3_stubs.c 側の構成（misc3.c と str_insert.c の本物を
# リンクする）を使う。居場所の窓口 src/player_pos.c も同じ（#18-6B5）。
$(BUILDDIR)/objdes_test: $(TESTDIR)/objdes_test.c \
                         $(TESTDIR)/misc3_stubs.c \
                         $(TESTDIR)/fixture.h $(TESTDIR)/minunit.h \
                         src/misc3.c src/stats.c src/str_insert.c src/desc.c \
                         src/tables.c src/inventory.c \
                         src/treasure.c src/player.c \
                         src/abilities.c src/progress.c \
                         src/score_death.c src/save_state.c \
                         src/player_pos.c | $(BUILDDIR)
	$(CC) $(CFLAGS) -o $@ $(TESTDIR)/objdes_test.c \
	    $(TESTDIR)/misc3_stubs.c src/misc3.c src/stats.c src/str_insert.c \
	    src/desc.c src/tables.c src/inventory.c \
	    src/treasure.c src/player.c src/abilities.c \
	    src/progress.c src/score_death.c src/save_state.c \
	    src/player_pos.c

# 文字列への差しこみ（insert_str / insert_lnum）は src/str_insert.c にある。
# 外部リンケージなのでそのまま呼べる。写しではなく実体を検証したいので
# str_insert.c をリンクする。
#
# この 2 関数がプロジェクト内に求めるシンボルは 0 個（strcpy / strcat /
# strlen / sprintf など標準ライブラリだけ）なので、代役ファイルもフィクスチャ
# も要らず、対象 1 本で足りる。str_insert_test.c は fixture.h を include する
# が fixture_reset() を呼ばないため、fixture.c / misc3_stubs.c は不要。
#
# #41B までは misc3.c と同居していたせいで 10 コンパイル単位を引いていた
# （str_insert_test.c misc3_stubs.c + misc3.c stats.c str_insert.c desc.c
# tables.c treasure.c player.c abilities.c）。#41C で 2 単位に減らした
# （src/ 側は 8 → 1）。
$(BUILDDIR)/str_insert_test: $(TESTDIR)/str_insert_test.c \
                             $(TESTDIR)/fixture.h $(TESTDIR)/minunit.h \
                             src/str_insert.c src/str_insert.h | $(BUILDDIR)
	$(CC) $(CFLAGS) -o $@ $(TESTDIR)/str_insert_test.c src/str_insert.c

# モンスター表の逆順走査は src/monsters.c の rbegin / rend / prev にある。
# 外部リンケージなのでそのまま呼べる。写しではなく実体を検証したいので
# monsters.c をリンクする。
#
# monsters.c が外に求めるのは is_a_vowel（src/desc.c）だけ。desc.c をリンクすると
# 定数表とインベントリまで芋づるで付いてくるので、代役をテスト側に置く。
# 検証したいのは走査の順序で、名前に冠詞を付ける処理は関係しない。
$(BUILDDIR)/creature_iterator_test: $(TESTDIR)/creature_iterator_test.c \
                                    $(TESTDIR)/minunit.h \
                                    src/monsters.c | $(BUILDDIR)
	$(CC) $(CFLAGS) -o $@ $(TESTDIR)/creature_iterator_test.c src/monsters.c

# セーブデータ中の真偽値の読み書きは src/save.c の wr_short / rd_bool にある。
# どちらも static なので外から呼べない。写しでは書きかえ後の実体を検証できず
# 保護にならないので、テスト側が src/save.c を #include して実体ごと取りこみ、
# static 関数を直接呼ぶ。ゆえに save.c は依存に書くがコンパイル対象には
# 並べない（二重定義になる）。
#
# save.c は 1300 行（セーブ／ロード全体）なので、取りこむと 77 個の未解決
# シンボルが芋づるで付いてくる。データ側（variable.c のグローバル、tables.c の
# 定数表、inventory.c のインベントリ、player.c の py、monsters.c の m_list）は
# 本物をリンクし、画面表示・入力・シグナル・店・乱数は save_stubs.c の代役で
# 埋める。一覧はリンカに列挙させたもので、手で数えあげたわけではない。
#
# 読み書きの相手は tmpfile()。fileptr / xor_byte も save.c の static なので
# テストから直接設定でき、実ファイルもセーブデータの雛形も要らない。
#
# オプションのビット詰めを src/options.c に寄せたので、save.c を取りこむと
# game_options_pack / game_options_unpack も要る。代役ではなく本物をリンクする
# （このテストが見ているのはバイト数と値の対応で、表は関係しないが、
# 実体をリンクしておけば表とセーブ側が食いちがえばここでも落ちる）。
#
# パネル数の読み書きも src/panel.c 越しになったので panel.c もリンクする。
# 依存が無い module なので代役より本物のほうが短い。
# 店 6 軒の記録も src/stores.c 越しになったので同じくリンクする。
#
# 持ち物と装備の読み書きも src/inventory.c 越しになったので inventory.c も
# リンクする。#18-5C で実体（inventory[] と 3 つの数え）も treasure.c から
# inventory.c に移って static になった。
#
# #19B4 で save.c がセーブ／進行メタ 13 個も窓口越しに読み書きするように
# なったので、progress.c / score_death.c / save_state.c もリンクする。足場
# （tests/*_fixture.c）は要らない —— この構成は variable.c の本物をリンクして
# いて、13 個の実体はまだそこにあるから。ステップ C で実体が 3 つの module の
# static に移っても、この 3 本をリンクしている形は変えなくてよい。
#
# #18-6B1 で save.c が居場所 2 個も src/player_pos.c の窓口越しに読み書きする
# ようになったので player_pos.c もリンクする（実体はまだ player.c にあるので
# 足場は要らない）。
$(BUILDDIR)/save_bool_test: $(TESTDIR)/save_bool_test.c \
                            $(TESTDIR)/save_stubs.c $(TESTDIR)/minunit.h \
                            src/save.c src/variable.c src/tables.c \
                            src/treasure.c src/player.c src/monsters.c \
                            src/options.c src/messages.c src/panel.c \
                            src/stores.c src/inventory.c \
                            src/progress.c src/score_death.c \
                            src/save_state.c src/player_pos.c | $(BUILDDIR)
	$(CC) $(CFLAGS) -o $@ $(TESTDIR)/save_bool_test.c \
	    $(TESTDIR)/save_stubs.c src/variable.c src/tables.c \
	    src/treasure.c src/player.c src/monsters.c src/options.c \
	    src/messages.c src/panel.c src/stores.c src/inventory.c \
	    src/progress.c src/score_death.c src/save_state.c src/player_pos.c

# 店 6 軒のセーブデータの並びは save.c の 3 か所（書き 1・読み 2）に同じ
# 項目の列が書かれていた。それを wr_store() / rd_store() にまとめる。実体は
# save.c の static なので、save_bool_test と同じく src/save.c を取りこみ、
# 代役も同じ tests/save_stubs.c を使いまわす。
#
# 店の記録の置き場は src/stores.c なので本物をリンクする（比べる相手が
# 本体と同じ記録でなければ意味が無い）。
#
# save.c が持ち物と装備の窓口を呼ぶので src/inventory.c もリンクする
# （save_bool_test と同じ理由）。居場所 2 個の窓口 src/player_pos.c も同じ。
$(BUILDDIR)/store_save_test: $(TESTDIR)/store_save_test.c \
                             $(TESTDIR)/save_stubs.c $(TESTDIR)/minunit.h \
                             src/save.c src/variable.c src/tables.c \
                             src/treasure.c src/player.c src/monsters.c \
                             src/options.c src/messages.c src/panel.c \
                             src/stores.c src/inventory.c \
                             src/progress.c src/score_death.c \
                             src/save_state.c src/player_pos.c | $(BUILDDIR)
	$(CC) $(CFLAGS) -o $@ $(TESTDIR)/store_save_test.c \
	    $(TESTDIR)/save_stubs.c src/variable.c src/tables.c \
	    src/treasure.c src/player.c src/monsters.c src/options.c \
	    src/messages.c src/panel.c src/stores.c src/inventory.c \
	    src/progress.c src/score_death.c src/save_state.c src/player_pos.c

# オプション 11 個の表は src/options.c にある。外部リンケージなのでそのまま
# 呼べる。値の置き場は本体のグローバル（variable.c）なので本物をリンクする。
# variable.c は定義だけの集まりで、他の .c を要求しない（この 2 つで足りる）。
#
# 書きこみ・読みこみの実体は save.c の sv_write() / rd_* の中に並んだ if 文
# だったので、関数として呼べない。テスト側に変更前の並びを写しとり
# （legacy_pack / legacy_unpack）、新しい実体と 2^11 通りすべてで
# 突きあわせている。#7（device.c）と同じ「テスト側に写す」方式。
$(BUILDDIR)/options_test: $(TESTDIR)/options_test.c $(TESTDIR)/minunit.h \
                          src/options.c src/options.h \
                          src/variable.c | $(BUILDDIR)
	$(CC) $(CFLAGS) -o $@ $(TESTDIR)/options_test.c src/options.c src/variable.c

# メッセージ履歴のリングバッファは src/messages.c にある。外部リンケージなので
# そのまま呼べる。輪そのもの（old_msg / last_msg）も messages.c が持つので、
# 他のソースは何も要らない（このテストの構成が最小になっているのは、そこに
# 寄せた結果そのもの）。
#
# 「輪の回りかた」は io.c / dungeon.c の関数の中に直に書かれていて外から
# 呼べなかったので、変更前の dungeon.c の辿りかたをテスト側に写しとり
# （legacy_walk_back）、新しい実体と突きあわせている。#7（device.c）や
# #18-1（options.c）と同じ「テスト側に写す」方式。
$(BUILDDIR)/messages_test: $(TESTDIR)/messages_test.c $(TESTDIR)/minunit.h \
                           src/messages.c src/messages.h | $(BUILDDIR)
	$(CC) $(CFLAGS) -o $@ $(TESTDIR)/messages_test.c src/messages.c

# パネル（画面が見せているダンジョンの範囲）の計算は src/panel.c にある。
# 外部リンケージなのでそのまま呼べる。10 個の値も panel.c が持つので、他の
# ソースは何も要らない（messages_test と同じく、この構成の短さがそこに
# 寄せた結果そのもの）。
#
# 導出（panel_bounds）も移動の判定（get_panel）も、変更前は misc1.c の関数の
# 中に直に書かれていた。get_panel は end_find() を呼ぶので、そのままでは
# ダンジョンと移動処理が芋づるで付いてくる。判定の部分だけを panel.c の
# panel_move_to() に取りだし、副作用（end_find）は misc1.c 側に残した。
# 変更前の 2 関数はテスト側に写しとって（legacy_bounds / legacy_get_panel）
# 新しい実体と総当たりで突きあわせている。#7 / #18-1 / #18-2 と同じ方式。
$(BUILDDIR)/panel_test: $(TESTDIR)/panel_test.c $(TESTDIR)/minunit.h \
                        src/panel.c src/panel.h | $(BUILDDIR)
	$(CC) $(CFLAGS) -o $@ $(TESTDIR)/panel_test.c src/panel.c

# 店 6 軒の記録は src/stores.c にある。置き場だけの module なので、リンクする
# のは stores.c 1 本きり（externs.h も variable.c も要らない）。
#
# 見るのは「置き場としてのふるまい」だけで、店の在庫の出し入れ（store1.c）や
# 値切り（store2.c）はここでは見ない。前者は t_list や object_list を、後者は
# 画面と入力を連れてくるので、この 1 本の潔さが保てなくなる。
$(BUILDDIR)/stores_test: $(TESTDIR)/stores_test.c $(TESTDIR)/minunit.h \
                         src/stores.c src/stores.h | $(BUILDDIR)
	$(CC) $(CFLAGS) -o $@ $(TESTDIR)/stores_test.c src/stores.c

# 持ち物と装備の置き場は src/inventory.c にある。#18-5C で配列と 3 つの件数の
# 実体が treasure.c から移ってきて static になったので、足場（かつて置いていた
# tests/inventory_fixture.c）はもう要らない。窓口は誰も呼ばないので代役も
# 1 つも要らず、リンクは対象 1 本＋テスト 1 本の 2 コンパイル単位で足りる
# （str_insert_test・stat_bonus_test と同じ形）。
$(BUILDDIR)/inventory_test: $(TESTDIR)/inventory_test.c \
                            $(TESTDIR)/minunit.h \
                            src/inventory.c src/inventory.h \
                            src/equipment.h | $(BUILDDIR)
	$(CC) $(CFLAGS) -o $@ $(TESTDIR)/inventory_test.c src/inventory.c

# 進行の置き場（turn・種 2 つ・wizard 2 つ）。#19C1 で 5 個の実体が
# src/progress.c の static になったので、足場（tests/progress_fixture.c）は
# 要らなくなった。窓口は誰も呼ばないので代役も 1 つも要らず、リンクは対象
# 1 本＋テスト 1 本の 2 コンパイル単位で足りる（inventory_test・
# str_insert_test・stat_bonus_test と同じ形）。
$(BUILDDIR)/progress_test: $(TESTDIR)/progress_test.c \
                           $(TESTDIR)/minunit.h \
                           src/progress.c src/progress.h | $(BUILDDIR)
	$(CC) $(CFLAGS) -o $@ $(TESTDIR)/progress_test.c src/progress.c

# 結末の置き場（death・died_from・birth_date・noscore）。progress_test と同じ形で、
# #19C1 で 4 個の実体が src/score_death.c の static になったので足場は消え、
# 2 コンパイル単位・代役 0 になった。
#
# highscore_fp はこの区分の global だがここには無い。display_scores() と
# highscores() が関数の中で fopen して fclose するだけなので局所変数にできる
# （ユーザーの判断）。ファイル操作を抱えないので externs.h（fopen を tfopen に
# 置きかえる）を include せずに済んでいる。
# #18-7-1C1 で total_winner と max_score の実体も src/score_death.c の static に
# なったので、ステップ A のあいだ要った足場（tests/score_death_fixture.c）は
# 消えた。2 コンパイル単位・代役 0 に戻っている。
$(BUILDDIR)/score_death_test: $(TESTDIR)/score_death_test.c \
                              $(TESTDIR)/minunit.h \
                              src/score_death.c src/score_death.h | $(BUILDDIR)
	$(CC) $(CFLAGS) -o $@ $(TESTDIR)/score_death_test.c src/score_death.c

# セーブの置き場（savefile・生成済み・保存済み・panic）と 3 つの述語。
# 3 module のうち唯一よそを読む側なので、この 1 本だけリンクが長い:
# save_state_has_live_character が score_death.h の player_is_dead を、
# save_state_character_is_in_play が progress.h の progress_turn を呼ぶ。
# よって src/ 側は 3 本、テスト 1 本で 4 コンパイル単位になる。それが有向依存の
# 代金で、隠さずに数えておく（progress_test / score_death_test はそれぞれ
# 2 単位）。#19C1 で 13 個の実体が 3 module の static になったので、足場
# 3 本（save_state_fixture.c・progress_fixture.c・score_death_fixture.c）は
# 消えた。代役は 1 つも要らない。
$(BUILDDIR)/save_state_test: $(TESTDIR)/save_state_test.c \
                             $(TESTDIR)/minunit.h \
                             src/save_state.c src/save_state.h \
                             src/progress.c src/progress.h \
                             src/score_death.c src/score_death.h | $(BUILDDIR)
	$(CC) $(CFLAGS) -o $@ $(TESTDIR)/save_state_test.c \
	    src/save_state.c src/progress.c src/score_death.c

# プレイヤーの居場所の置き場（char_row・char_col）。#18-6C1 で実体が
# src/player_pos.c の static になったので、足場（tests/player_pos_fixture.c）は
# 要らなくなった。窓口は誰も呼ばないので代役も 1 つも要らず、リンクは対象
# 1 本＋テスト 1 本の 2 コンパイル単位で足りる（progress_test・score_death_test・
# inventory_test・str_insert_test と同じ形）。
$(BUILDDIR)/player_pos_test: $(TESTDIR)/player_pos_test.c \
                             $(TESTDIR)/minunit.h \
                             src/player_pos.c src/player_pos.h | $(BUILDDIR)
	$(CC) $(CFLAGS) -o $@ $(TESTDIR)/player_pos_test.c src/player_pos.c

clean:
	rm -rf $(BUILDDIR)
