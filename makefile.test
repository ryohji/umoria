# makefile.test -- 単体テストのビルドと実行
#
# 本体の makefile とは独立している。理由は 2 つ。
#   1. 本体は ncurses を必要とするが、テスト対象のロジック層は必要としない。
#      テストだけを ncurses なしで動かせるようにしておく。
#   2. テストの追加が本体のビルドに影響しないようにする。
#
# 使い方:
#   make -f makefile.test          # 全テストをビルドして実行
#   make -f makefile.test clean

CC = gcc
STD = -std=c17
# 本体（makefile:18-20）に近づけているが、同一ではない。
# 本体にあってここに無いもの:
#   -Wpedantic            本体ヘッダ（externs.h）由来の警告が数百件出て、
#                         テスト自身の問題が埋もれる
#   -Wmissing-prototypes  代役ファイルは本体の宣言（externs.h）を include
#                         しない設計なので、原理的に全代役が警告になる
#   -Wnested-externs      fixture_reset() が関数内 extern でグローバルを
#                         参照する形なので、意図的にこの形を使っている
# これらを外した状態で、テストコード由来の警告は 0 件を保つ。
WARNINGS = -Wall -Wextra -Wno-unused-parameter \
           -Wshadow -Wstrict-prototypes -Wold-style-definition \
           -Wformat=2 -Wwrite-strings
# 以前はここに本体由来の既存警告（非プロトタイプ宣言・const の落ち・
# 文字列リテラルへの書きこみ等、数千件）の抑制を並べていた。本体側の
# 警告解消でどれも 0 件になったので、抑制ごと外した。テスト・本体とも
# この設定で警告 0 件。
# -I は src/ とそのサブディレクトリー（sources.mk の SRC_SUBDIRS）と tests/。
# #include "..." はヘッダの名前だけで書いてあるので、ヘッダのあるディレクトリー
# はすべて要る。src/ の .c を丸ごと #include するテスト（下の「気をつける
# こと」の 2）も、この -I でその .c を見つける。
CFLAGS = $(STD) $(WARNINGS) -g -Isrc $(addprefix -Isrc/,$(SRC_SUBDIRS)) -Itests
TESTDIR = tests
BUILDDIR = $(TESTDIR)/build

# テストは 1 実行形式につき 1 対象モジュール。
# 対象を増やすときは、ここに <name>_test を足す。tests/ の足場（代役・
# fixture）を一緒にリンクするなら、下の「足場の表」に 1 行書く。src/ の
# .c はどこにも書かない（libcore.a からリンカが要るものだけを引く）。
TESTS = distance_test geometry_test los_test device_chance_test item_ident_test inven_stack_test \
        put_misc3_test haggle_comment_test movement_rate_test \
        stat_bonus_test objdes_test creature_iterator_test save_bool_test \
        options_test messages_test panel_test stores_test store_save_test \
        savefile_version_test \
        str_insert_test inventory_test progress_test score_death_test \
        concat_test \
        save_state_test player_pos_test hp_table_test \
        calc_hitpoints_test player_light_test burden_test \
        check_strength_test calc_spells_test gain_spells_test \
        spells_known_test object_levels_test missile_serial_test \
        screen_touched_test inven_command_state_test \
        level_exit_test pending_teleport_test input_ended_test \
        running_test command_state_test direction_keys_test player_gold_test player_food_test \
        player_display_numbers_test player_mana_test player_hp_test \
        player_level_test player_status_flags_test player_abilities_test \
        player_timed_effects_test player_resting_test player_speed_test \
        player_infra_range_test player_glowing_hands_test \
        player_spells_to_learn_test player_max_depth_test \
        player_hit_die_test player_armour_class_test \
        player_base_to_hit_test player_disarm_test \
        player_saving_throw_test player_race_test player_body_weight_test \
        player_attack_bonuses_test player_search_skill_test \
        player_bio_test player_stealth_test player_class_test \
        monster_turn_test monster_levels_test monster_breeding_test \
        monster_list_test dungeon_size_test dungeon_level_test \
        floor_items_test dungeon_map_test

BINS = $(addprefix $(BUILDDIR)/,$(TESTS))

.PHONY: all clean run
all: run

# 全テストを実行し、1 つでも失敗したら全体を失敗にする。
# グリーン／レッドがひと目でわかることが目的。
run: $(BINS)
	@echo "== running unit tests =="
	@fail=0; for t in $(BINS); do \
		echo "--- $$t ---"; \
		$$t || fail=1; \
	done; \
	echo; \
	if [ $$fail -eq 0 ]; then \
		echo "RESULT: GREEN"; \
	else \
		echo "RESULT: RED"; \
	fi; \
	exit $$fail

$(BUILDDIR):
	@mkdir -p $(BUILDDIR)

# ---- 本体のライブラリー（libcore.a）----------------------------------------
# src/ の .c の一覧は sources.mk に 1 つだけ書いてある（本体の makefile と
# makefile.win も同じものを読む）。そのうち CORE_SRCS（main.c と ncurses を
# 直に呼ぶ 2 本を除いたもの）を、テストと同じ CFLAGS で 1 本ずつ .o にして
# 1 つの archive にまとめる。archive は 1 つだけにする（分けると互いに呼び
# あってリンクの順番が壊れる。docs/refactoring/done/layout.md の L）。
#
# LIB_EXCLUDE の 3 本は入れない。どのテストもリンクしておらず、テストの
# CFLAGS（-O2 も -D_DEFAULT_SOURCE も無い）でコンパイルすると警告が出る
# （dungeon.c と inven_menu.c は -Wformat-overflow が 1 件と 4 件、signals.c は
# kill() と sigsetmask() の暗黙宣言 2 件）。テストのフラグは変えない約束
# なので、要るテストが現れたときに入れかたを決める。
include sources.mk

# LIB_EXCLUDE は名前だけで書く（%/ の形で、どのディレクトリーにあっても当たる）。
# .o はディレクトリーを落とした名前で tests/build/core/ に並べ、.c は vpath で
# src/ とそのサブディレクトリーから探す（名前は src/ の中で重ならない）。
LIB_EXCLUDE = dungeon.c inven_menu.c signals.c
LIB_SRCS = $(filter-out $(LIB_EXCLUDE) $(addprefix %/,$(LIB_EXCLUDE)),$(CORE_SRCS))
LIBOBJDIR = $(BUILDDIR)/core
LIB_OBJS = $(addprefix $(LIBOBJDIR)/,$(notdir $(LIB_SRCS:.c=.o)))
vpath %.c src $(addprefix src/,$(SRC_SUBDIRS))
LIBCORE = $(BUILDDIR)/libcore.a

$(LIBOBJDIR):
	@mkdir -p $(LIBOBJDIR)

# -MMD -MP で、.o ごとに「その .c が取りこんだ src/ と tests/ のヘッダ」を
# tests/build/core/<name>.d に書かせて読む。以前はどの規則も types.h・
# constant.h・config.h を依存に書いていなかったので、共有ヘッダを書きかえても
# 古い実行形式が使いまわされた（HANDOVER 第 7 節）。いまは共有ヘッダが
# 変われば、それを取りこむ .o → libcore.a → 全テストの順に作りなおされる。
# -MMD -MP は依存の一覧を書き出すだけで、.o の中身は変えない。
$(LIBOBJDIR)/%.o: %.c | $(LIBOBJDIR)
	$(CC) $(CFLAGS) -MMD -MP -c -o $@ $<

-include $(LIB_OBJS:.o=.d)

$(LIBCORE): $(LIB_OBJS)
	rm -f $@
	$(AR) rcs $@ $(LIB_OBJS)

.PHONY: libcore
libcore: $(LIBCORE)

# ---- テストの実行形式（型の規則）------------------------------------------
# 実行形式はどれも「tests/<name>.c ＋ 足場の表の tests/ のファイル ＋
# libcore.a」を 1 回の $(CC) でコンパイルしてリンクする。src/ の .o は
# archive から、リンカが未解決の名前を埋めるのに要るものだけが引かれる。
# 何が引かれたかは tests/build/<name>.map に出る（scripts/link_units.py で
# 実行形式ごとに一覧にできる）。
#
# 以前は 74 本それぞれに手書きの recipe（依存行とリンク行に src/*.c を
# 並べたもの）と、なぜその .c をリンクするかの解説があった。その最後の版は
# git show ad67a707:makefile.test で読める。archive に替えるときに、74 本
# すべてで Map に出るメンバーが旧 recipe の src/*.c と一致することを機械で
# 確かめた（一致しなかったのは save_bool_test と store_save_test の 2 本で、
# 旧 recipe が並べていた src/tables.c と src/treasure.c をどちらも誰も
# 参照していなかった。引かれないだけで、テストの結果は変わらない）。
#
# 気をつけること 2 つ。
#   1. 代役（tests/*_stubs.c・*_fixture.c）の名前は、archive の本物より先に
#      リンカが見るので必ず代役が使われる。逆に、代役を消しても赤くならない
#      ことがある —— 手書きの recipe なら undefined reference で止まった
#      ところを、archive は黙って本物で埋める。代役を消したら
#      scripts/link_units.py で引かれた .o を見る。
#   2. src/ の .c を丸ごと #include するテスト（save_bool_test・
#      store_save_test・savefile_version_test は save.c、haggle_comment_test
#      は store_haggle.c、movement_rate_test は creature.c）では、その .c の名前はテスト自身が
#      定義しているので、archive の同じ .o は引かれない。src/ の .c が
#      変わると libcore.a が作りなおされ、それに依存する全テストがリンクし
#      なおされるので、#include した .c の変更も拾われる。
TEST_HEADERS = $(wildcard $(TESTDIR)/*.h)

# ---- 足場の表 ---------------------------------------------------------------
# 実行形式ごとに、tests/<name>.c と一緒にリンクする tests/ のファイル。
# 書いていない実行形式は tests/<name>.c だけ（＋ libcore.a）。
EXTRA_calc_hitpoints_test = shared_stubs.c level_ops_fixture.c
EXTRA_calc_spells_test = shared_stubs.c spellbook_fixture.c
EXTRA_check_strength_test = shared_stubs.c inven_ops_fixture.c
EXTRA_gain_spells_test = shared_stubs.c spellbook_fixture.c
EXTRA_geometry_test = shared_stubs.c
EXTRA_haggle_comment_test = shared_stubs.c store_haggle_fixture.c
EXTRA_los_test = shared_stubs.c
EXTRA_inven_stack_test = shared_stubs.c inven_ops_fixture.c
EXTRA_objdes_test = shared_stubs.c desc_fixture.c
EXTRA_object_levels_test = shared_stubs.c object_levels_fixture.c
EXTRA_put_misc3_test = shared_stubs.c char_screen_fixture.c
EXTRA_save_bool_test = save_stubs.c
EXTRA_store_save_test = save_stubs.c
EXTRA_savefile_version_test = save_stubs.c
EXTRA_movement_rate_test = shared_stubs.c creature_stubs.c
EXTRA_item_ident_test = fixture.c
EXTRA_floor_items_test = floor_items_fixture.c
EXTRA_monster_list_test = monster_list_fixture.c
EXTRA_player_class_test = player_class_fixture.c
EXTRA_player_level_test = player_level_fixture.c
EXTRA_player_race_test = player_race_fixture.c
EXTRA_stat_bonus_test = stats_fixture.c

.SECONDEXPANSION:
$(BINS): $(BUILDDIR)/%: $(TESTDIR)/%.c $$(addprefix $(TESTDIR)/,$$(EXTRA_$$*)) \
                        $(TEST_HEADERS) $(LIBCORE) | $(BUILDDIR)
	$(CC) $(CFLAGS) -o $@ $(TESTDIR)/$*.c $(addprefix $(TESTDIR)/,$(EXTRA_$*)) \
	    $(LIBCORE) -Wl,-Map,$@.map

clean:
	rm -rf $(BUILDDIR)
